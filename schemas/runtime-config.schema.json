{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fishing/v0.1/runtime-config.schema.json",
  "title": "Fishing v0.1 runtime config",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "visible_fps", "bite_wait_min_sec", "bite_wait_max_sec", "basket_capacity"],
  "properties": {
    "config_version": {"const": 1},
    "visible_fps": {"const": 30},
    "bite_wait_min_sec": {"type": "number", "minimum": 1, "maximum": 86400},
    "bite_wait_max_sec": {"type": "number", "minimum": 1, "maximum": 86400},
    "basket_capacity": {"type": "integer", "minimum": 1}
  },
  "$comment": "Validate bite_wait_min_sec <= bite_wait_max_sec in ConfigLoader. 20-60s are owner-approved initial config values; only owner may approve tuning changes. basket_capacity=10 remains a candidate, not schema const."
}
