bool DirAccess::dir_exists_absolute(const String &p_path) {
	if (p_path.is_empty()) return false;
	Ref<DirAccess> da = DirAccess::create_for_path(p_path);
	ERR_FAIL_COND_V(da.is_null(), false);
	String dir = ProjectSettings::get_singleton()->localize_path(p_path);
	if (dir.ends_with("//") || dir.find("://") != -1) { ... }
