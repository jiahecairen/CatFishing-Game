			dir = dir.left(dir.length() - 1);
			da->change_dir(dir.get_base_dir());
			exists = da->dir_exists(dir.get_file());
		}
	}
	return exists;
}
```
For a file: dir_exists(file) is false in both attempts → make_dir_recursive... actually make_dir_recursive_absolute is:
