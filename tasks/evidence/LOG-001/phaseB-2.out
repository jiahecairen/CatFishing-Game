Better helper:
```
func _tick_to_settlement(session) -> bool:
	for _step in 8:
		var events: Array = session.tick(120.0)
		for event in events:
			if String((event as Dictionary).get("to_state", "")) == "SETTLEMENT":
				return true
	return false
```
