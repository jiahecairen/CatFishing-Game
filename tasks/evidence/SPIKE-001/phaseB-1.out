Writing the final script:

```gdscript
extends Node2D
# SPIKE-001 GUI behavior probe: transparent passthrough variants, drag threshold, position persistence, 30FPS sliding window, self-screenshot.
# Constraints:
# - Logic/timing only via Time.get_ticks_msec(); no frame counting for logic (FPS stats are just a sliding window over timestamps too).
# - Only call Window properties whose existence was verified by get_property_list(); if the API is absent, record `unsupported` and write it to the report as-is.
# - Do not implement economy/FSM/business saves; user:// only stores window geometry (a temporary probe, not a v0.1 official save).

const SAVE_PATH := "user://spike_window.json"
const STATE_PATH := "res://report/observed_state.json"
const MATRIX_PATH := "res://report/variant_matrix.json"
const DRAG_THRESHOLD_PX := 6.0
const DEFAULT_POS := Vector2i(120, 120)

var _win: Window
var _variant := "init"
var _variant_api: Dictionary = {}
var _variant_log: Array = []
var _events: Array = []
var _ship_clicks := 0
var _drag_pending := false
var _dragging := false
var _drag_start_mouse := Vector2.ZERO
var _drag_start_win := Vector2i.ZERO
var _fps_window_start_ms := 0
var _fps_window_frames := 0
var _fps_last := 0.0
var _fps_samples: Array = []
var _hidden := false
```

_ready:
```
_win = get_window()
_engine caps
Engine.max_fps = 30
_variant_api = {
  "mouse_passthrough": _has_prop("mouse_passthrough"),
  "mouse_passthrough_mode": _has_prop("mouse_passthrough_mode"),
  "mouse_passthrough_polygon": _has_prop("mouse_passthrough_polygon"),
  "transparent": _has_prop("transparent"),
  "borderless": _has_prop("borderless"),
  "always_on_top": _has_prop("always_on_top"),
  "unfocusable": _has_prop("unfocusable"),
}
if _variant_api["transparent"]: _win.set("transparent", true)
if _variant_api["borderless"]: _win.set("borderless", true)
if _variant_api["always_on_top"]: _win.set("always_on_top", true)
_restore_position()
$Ship.gui_input.connect(_on_ship_gui_input)
_win.visibility_changed.connect(_on_visibility_changed)
_set_variant("off")
_update_status()
_fps_window_start_ms = Time.get_ticks_msec()
_log_event("ready")
```

_process: count frames; compute fps each second; update status every 1 second? Updating the status label text every second is fine.

_unhandled_input: key handling.

_set_variant(name):
```
var supported := true
var mode := 0
match name:
  "full": enable=1, polygon=empty
  "polygon": enable=1; polygon required → supported = _variant_api["mouse_passthrough_polygon"]; if unsupported: record and set to disabled
  "off": enable=0
apply:
