Drag:
```
func _on_ship_gui_input(event):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			_drag_pending = true; _dragging=false
			_drag_start_mouse = event.global_position
			_drag_start_win = _win.position
		else:
			if _drag_pending:
				if not _dragging:
					_ship_clicks += 1
					_log_event("ship_click")
				_save_position()
			_drag_pending=false; _dragging=false
			_update_status()
	elif event is InputEventMouseMotion and _drag_pending:
		var d: Vector2 = event.global_position - _drag_start_mouse
		if not _dragging and d.length() >= DRAG_THRESHOLD_PX:
			_dragging = true
			_log_event("drag_start")
		if _dragging:
			_win.position = Vector2i(_drag_start_win + d.round())
```

Note: while dragging, the mouse may leave the ship (the window moves with the mouse and the cursor stays over the ship, so it usually stays within the ship region… actually, the window follows the mouse, so the cursor stays at the same offset position relative to the window → stays over the ship). Good.

_restore_position:
```
var pos := DEFAULT_POS
var src := "default"
if FileAccess.file_exists(SAVE_PATH):
	var f := FileAccess.open(SAVE_PATH, FileAccess.READ)
	if f: parse JSON; if data is Dictionary and has x,y: pos = Vector2i(int(d.x), int(d.y)); src="saved"
	(on failure → fallback, log an event)
clamp to the safe area (0):
var area: Rect2i = DisplayServer.get_display_safe_area(0)
if area.size.x >= _win.size.x and area.size.y >= _win.size.y:
	pos.x = clampi(pos.x, area.position.x, area.position.x + area.size.x - _win.size.x)
	same for y
_win.position = pos
```
