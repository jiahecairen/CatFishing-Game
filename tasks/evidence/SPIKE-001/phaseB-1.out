capability_probe.gd:

```gdscript
extends Node
# SPIKE-001 capability probe (automated gate + recording for GUI mode).
# Only probes window/renderer capabilities, no business logic. In headless, writes res://report/capability.json then quits.

const REPORT_PATH := "res://report/capability.json"
const WINDOW_PROPERTIES: PackedStringArray = [
	"mouse_passthrough",
	"mouse_passthrough_mode",
	"mouse_passthrough_polygon",
	"transparent",
	"borderless",
	"always_on_top",
	"unfocusable",
	"visible",
	"gui_embed_subwindows",
]

func _ready() -> void:
	var report := {
		"engine_version": str(Engine.get_version_info().get("string", "unknown")),
		"display_server": DisplayServer.get_name(),
		"headless": DisplayServer.get_name() == "headless",
		"display_count": -1,
		"main_display_safe_area": null,
		"rendering_method": "unknown",
		"window_properties": {},
		"property_values": {},
		"ts_utc": Time.get_datetime_string_from_system(true, true),
	}
	# RenderingServer/get_current_rendering_method: headless (dummy) also has a valid return value
	report["rendering_method"] = str(RenderingServer.get_current_rendering_method())
	if DisplayServer.get_name() != "headless":
		report["display_count"] = DisplayServer.get_display_count()
		var area := DisplayServer.get_display_safe_area(0)  # Hmm, is the default arg safe? Explicitly pass 0
		report["main_display_safe_area"] = [area.position.x, area.position.y, area.size.x, area.size.y]
	var win := get_window()
	var props := win.get_property_list()
	for prop_name in WINDOW_PROPERTIES:
		var exists := false
		for p in props:
			if p["name"] == prop_name:
				exists = true
				break
		report["window_properties"][prop_name] = exists
		if exists:
			var value: Variant = win.get(prop_name)
			if value is PackedVector2Array:
				var pts: Array = []
				for pt in (value as PackedVector2Array):
					pts.append([pt.x, pt.y])
				report["property_values"][prop_name] = pts
			else:
				report["property_values"][prop_name] = value
	_write_json(REPORT_PATH, report)
	if report["headless"]:
		get_tree().quit()  # headless gate: only verify load/probe, don't stand in as GUI evidence


func _write_json(path: String, data: Variant) -> void:
	var dir := DirAccess.open("res://")
	if dir != null and not dir.dir_exists(path.get_base_dir()):
		dir.make_dir_recursive(path.get_base_dir())
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		push_warning("SPIKE-001: cannot write %s (err=%d)" % [path, FileAccess.get_open_error()])
		return
	file.store_string(JSON.stringify(data, "  ") + "\n")
	file.close()
```

Note: `DirAccess.open("res://")` in headless mode—res:// is writable (since running from source). dir_exists/get_base_dir: path.get_base_dir() of "res://report/capability.json" is "res://report". make_dir_recursive("report")? DirAccess.open("res://") returns a DirAccess rooted at res://, and make_dir_recursive("report") is relative from there. Alternatively, use the static variant `DirAccess.make_dir_recursive_absolute("res://report")`—simpler:

```gdscript
DirAccess.make_dir_recursive_absolute(path.get_base_dir())
```

Use this one.

Typing: `var area := DisplayServer.get_display_safe_area(0)` → Rect2i.

Note: `p["name"]`—entries of get_property_list's Dictionary have a "name" key. OK.

Typed as `var props := win.get_property_list()` → Array[Dictionary]. No problem.

The bool for `"headless"`—JSON serialization of bool is OK.

overlay_window.gd:

```gdscript
extends Node2D
# SPIKE-001 GUI behavior probe (manual acceptance-run; Phase B automation only runs headless load).
# Window capabilities + window geometry persistence only; no economy/FSM/business saves.
# Frame count must not be used for logic timing: FPS statistics and persistence timestamps all use Time.get_ticks_msec()/UTC time.

const DRAG_THRESHOLD_PX := 6.0
const SAVE_PATH := "user://spike_window.json"
const VARIANT_LOG_PATH := "res://report/variant_matrix.json"
const STATE_PATH := "res://report/observed_state.json"
const EVIDENCE_DIR := "res://evidence"
const DEFAULT_POS := Vector2i(120, 120)

@onready var _win: Window = get_window()
@onready var _ship: ColorRect = $Ship
@onready var _status: Label = $Status

var _variant := "off"
var _variant_log: Array = []
var _screenshot_paths: Array = []
var _press_pending := false
var _dragging := false
var _press_global := Vector2.ZERO
var _press_window_pos := Vector2.ZERO
var _fps_frames := 0
var _fps_window_start_ms := 0
var _fps_last := -1.0
var _screenshot_count := 0
var _finalized := false


func _ready() -> void:
	Engine.max_fps = 30  # SDD-175: fixed 30 FPS when visible
	_win.set("borderless", true)
	_win.set("transparent", true)
	_win.set("always_on_top", true)
	if _window_has_property("mouse_passthrough"):
		_win.set("mouse_passthrough", false)
	if _window_has_property("mouse_passthrough_polygon"):
		_win.set("mouse_passthrough_polygon", PackedVector2Array())
	_restore_position()
	_ship.gui_input.connect(_on_ship_gui_input)
	_win.visibility_changed.connect(_on_visibility_changed)
	_fps_window_start_ms = Time.get_ticks_msec()
	_status.text = _status_text()


func _process(_delta: float) -> void:
	# Sliding window FPS: uses Time.get_ticks_msec(), never get_frames_drawn()/frame counts for business timing
	_fps_frames += 1
	var now_ms := Time.get_ticks_msec()
	var elapsed_ms := now_ms - _fps_window_start_ms
	if elapsed_ms >= 1000:
		_fps_last = float(_fps_frames) * 1000.0 / float(elapsed_ms)
		_fps_frames = 0
		_fps_window_start_ms = now_ms
		_status.text = _status_text()


func _unhandled_input(event: InputEvent) -> void:
	if not (event is InputEventKey) or not event.pressed or event.echo:
		return
	match event.keycode:
		KEY_1:
			_set_variant("full_passthrough")
		KEY_2:
			_set_variant("polygon_passthrough")
		KEY_3:
			_set_variant("off")
		KEY_9:
			_take_screenshot()
		KEY_Q:
			_win.release_focus()  # After releasing focus, clicks on the transparent area can reach the App below, so click pass-through is easier to observe
		_:
			pass
```

Wait: does `match event.keycode` using an enum like KEY_1 work—yes, constants are permitted in match.

Note: in headless, _unhandled_input will never fire; no problem.

_set_variant:

```gdscript
func _set_variant(variant: String) -> void:
	var polygon_supported := _window_has_property("mouse_passthrough_polygon")
	var full_supported := _window_has_property("mouse_passthrough")
	var applied := variant
	var note := ""
	match variant:
		"full_passthrough":
			if full_supported:
				_win.set("mouse_passthrough", true)
				if polygon_supported:
					_win.set("mouse_passthrough_polygon", PackedVector2Array())
				note = "Full-window pass-through: transparent area and hull area should all be clickable (control group)"
			else:
				applied = "unsupported"
				note = "mouse_passthrough property does not exist"
		"polygon_passthrough":
			if polygon_supported:
				_win.set("mouse_passthrough", true)
				var size := _win.get("size") as Vector2i
				var rect_poly := PackedVector2Array([
					Vector2.ZERO,
					Vector2(float(size.x), 0.0),
					Vector2(float(size.x), float(size.y)),
					Vector2(0.0, float(size.y)),
				])
				_win.set("mouse_passthrough_polygon", rect_poly)
				note = "Pass-through polygon=full-window rectangle (verify semantics manually: whether the hull area is still clickable, record actual behavior in the matrix)"
			else:
				applied = "unsupported"
				note = "mouse_passthrough_polygon property does not exist"
		"off":
			_win.set("mouse_passthrough", false) if full_supported else null  # Hmm, ternary operator with null as expression? GDScript ternary needs both branches as expressions; `x if c else null` is OK but awkward
			...
```

Rewrite "off" cleanly with if statements:

```gdscript
		"off":
			if full_supported:
				_win.set("mouse_passthrough", false)
			if polygon_supported:
				_win.set("mouse_passthrough_polygon", PackedVector2Array())
			note = "Close pass-through: all windows are clickable (control group)"
	_variant = applied
	_log_variant(variant, note)
	_status.text = _status_text()
	_write_reports()
```

Also, the initial variant "off" is recorded at ready time—call _log_variant in _ready? The log is recorded only on key press + finalization on exit. Keep it: don't add the initial record.

_log_variant:

```gdscript
func _log_variant(requested: String, note: String) -> void:
	var entry := {
		"requested": requested,
		"effective_variant": _variant,
		"ts_utc": Time.get_datetime_string_from_system(true, true),
		"mouse_passthrough_effective": _win.get("mouse_passthrough") if _window_has_property("mouse_passthrough") else null,
		"polygon_supported": _window_has_property("mouse_passthrough_polygon"),
		"polygon_point_count": 0,
		"fps_last": _fps_last,
		"human_observed": "",  # Fill this column in during manual acceptance
		"note": note,
	}
	if entry["polygon_supported"]:
		var poly: PackedVector2Array = _win.get("mouse_passthrough_polygon")
		entry["polygon_point_count"] = poly.size()
	_variant_log.append(entry)
```

`entry["polygon_supported"]` is a Variant bool—using it as an if condition is OK.

`_win.get("mouse_passthrough") if ... else null`—a ternary Variant; assignment to a dict literal value is OK. Hmm, ternary inside a dict literal is fine.

_on_ship_gui_input:

```gdscript
func _on_ship_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			_press_pending = true
			_dragging = false
			_press_global = event.global_position
			_press_window_pos = Vector2(_win.get("position"))
			_status.text = _status_text()
		else:
			var was_drag := _dragging
			_press_pending = false
			_dragging = false
			if was_drag:
				_save_position()  # After drag release, persist; a normal click won't falsely trigger a drag
			_status.text = _status_text()
	elif event is InputEventMouseMotion and _press_pending:
		var delta: Vector2 = event.global_position - _press_global
		if not _dragging and delta.length() >= DRAG_THRESHOLD_PX:
			_dragging = true
			_status.text = _status_text()
		if _dragging:
			_win.set("position", Vector2i(_press_window_pos + delta))
```

`Vector2(_win.get("position"))`—Vector2() constructor from Vector2i: `Vector2(Vector2i)` is a valid constructor. OK.

`event.global_position` on InputEventMouseButton/Motion is Vector2. OK.

_restore_position:

```gdscript
func _restore_position() -> void:
	var pos := DEFAULT_POS
	var source := "default"
	var data: Variant = _read_json(SAVE_PATH)
	if typeof(data) == TYPE_DICTIONARY and data.has("x") and data.has("y"):
		pos = Vector2i(int(data["x"]), int(data["y"]))
		source = "user://spike_window.json"
	var area := _safe_area_or_null()
	if area != null:
		var a := area as Rect2i
		pos.x = clampi(pos.x, a.position.x, a.position.x + a.size.x - _win.get("size").x)
		pos.y = clampi(pos.y, a.position.y, a.position.y + a.size.y - _win.get("size").y)
	_win.set("position", pos)
	_position_source = source
```

`_win.get("size").x`—Variant member access on Vector2i: Variant member access compiles but at runtime... `(_win.get("size") as Vector2i).x` is safer. Rewrite:

```gdscript
	var win_size: Vector2i = _win.get("size")
```

Assignment of Variant → typed variable is permitted (runtime cast). OK.

_safe_area_or_null:

```gdscript
func _safe_area_or_null() -> Variant:
	if DisplayServer.get_name() == "headless":
		return null  # No real screen in headless (dummy); don't fake geometry evidence
	var area: Rect2i = DisplayServer.get_display_safe_area(0)
	if area.size.x <= 0 or area.size.y <= 0:
		return null
	if area.size.x < int(_win.get("size").x) or area.size.y < int(_win.get("size").y):
		return null
	return area
```

Also clamp to min. If safe area is invalid (screen disconnected) → keep default.

_save_position:

```gdscript
func _save_position() -> void:
	var pos: Vector2i = _win.get("position")
	var win_size: Vector2i = _win.get("size")
	var data := {
		"x": pos.x,
		"y": pos.y,
		"width": win_size.x,
		"height": win_size.y,
		"display_hint": 0,
		"ts_utc": Time.get_datetime_string_from_system(true, true),
	}
	_write_json(SAVE_PATH, data)
```

_on_visibility_changed:

```gdscript
func _on_visibility_changed() -> void:
	# When hidden, stop extra drawing (G-004); don't exit
	OS.set("low_processor_usage_mode", not bool(_win.get("visible")))
```

Hmm `bool(_win.get("visible"))` is fine.

_take_screenshot:

```gdscript
func _take_screenshot() -> void:
	DirAccess.make_dir_recursive_absolute(EVIDENCE_DIR)
	_screenshot_count += 1
	var stamp := Time.get_datetime_string_from_system(true, true).replace(":", "").replace("-", "").replace(".", "")
	var path := "%s/spike_%02d_%s.png" % [EVIDENCE_DIR, _screenshot_count, stamp]
	var tex := get_viewport().get_texture()
	var img := tex.get_image()
	var err := img.save_png(path)
	_screenshot_paths.append({"path": path, "err": err})
	_log_variant("screenshot", "viewport self-capture only, err=%d" % err)
	_write_reports()
```

_notification:

```gdscript
func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		_finalize()
```

_finalize:

```gdscript
func _finalize() -> void:
	if _finalized:
		return
	_finalized = true
	_save_position()
	_write_reports()
	get_tree().quit()
```

_write_reports writes both variant_matrix (an array including context) and observed_state:

```gdscript
func _write_reports() -> void:
	var win_size: Vector2i = _win.get("size")
	var pos: Vector2i = _win.get("position")
	var matrix := {
		"engine_version": str(Engine.get_version_info().get("string", "unknown")),
		"display_server": DisplayServer.get_name(),
		"rendering_method": str(RenderingServer.get_current_rendering_method()),
		"renderer_note": "The actual effective value under headless may be dummy; Metal/Compatibility proof must be taken from GUI manual runs",
		"variants": _variant_log,
		"ts_utc": Time.get_datetime_string_from_system(true, true),
	}
	_write_json(VARIANT_LOG_PATH, matrix)
	var state := {
		"engine_version": str(Engine.get_version_info().get("string", "unknown")),
		"display_server": DisplayServer.get_name(),
		"headless": DisplayServer.get_name() == "headless",
		"rendering_method": str(RenderingServer.get_current_rendering_method()),
		"window": {
			"position": [pos.x, pos.y],
			"size": [win_size.x, win_size.y],
			"borderless_effective": _win.get("borderless") if _window_has_property("borderless") else null,
			"transparent_effective": _win.get("transparent") if _window_has_property("transparent") else null,
			"always_on_top_effective": _win.get("always_on_top") if _window_has_property("always_on_top") else null,
			"mouse_passthrough_effective": _win.get("mouse_passthrough") if _window_has_property("mouse_passthrough") else null,
		},
		"position_source": _position_source,
		"drag_threshold_px": DRAG_THRESHOLD_PX,
		"engine_max_fps": Engine.get_max_fps(),
		"fps_last_window": _fps_last,
		"fps_method": "Time.get_ticks_msec() 1s sliding window; frame counting prohibited",
		"variants": _variant_log,
		"screenshots": _screenshot_paths,
		"ts_utc": Time.get_datetime_string_from_system(true, true),
	}
	_write_json(STATE_PATH, state)
```

`Engine.get_max_fps()` exists. `_win.get("borderless")` returns a Variant bool → JSON OK.

Helper functions _window_has_property, _write_json, _read_json (duplicated in both scripts—acceptable for a spike; or make it static in preload. Keep the duplication small, that's fine).

_read_json:

```gdscript
func _read_json(path: String) -> Variant:
	if not FileAccess.file_exists(path):
		return null
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return null
	var text := file.get_as_text()
	file.close()
	var json := JSON.new()
	if json.parse(text) != OK:
		return null
	return json.data
```

_status_text:

```gdscript
func _status_text() -> void:
```

Wait, the return value is a String:

```gdscript
func _status_text() -> String:
	var pos: Vector2i = _win.get("position")
	var fps := "n/a" if _fps_last < 0.0 else "%.1f" % _fps_last
	var drag_state := "IDLE"
	if _dragging:
		drag_state = "DRAG"
	elif _press_pending:
		drag_state = "HOLD"
	return "SPIKE-001 [%s] fps=%s pos=%d,%d | 1=passthrough 2=polygon 3=off 9=shot Q=unfocus" % [
		_variant, fps, pos.x, pos.y, drag_state]
```

Hmm, mismatched placeholder count—note the format: 5 placeholders [%s %s %d %d %d]... "pos=%d,%d" has 2 %d's, and at the end drag_state needs %s. Write it like this: `"SPIKE-001 [%s] fps=%s pos=%d,%d %s | 1=passthrough 2=polygon 3=off 9=shot Q=unfocus" % [_variant, fps, pos.x, pos.y, drag_state]`.

`_fps_last < 0.0` is fine.

@onready variables: _ship and _status via $Ship/$Status. If the scene is renamed... keep it consistent.

Also, `KEY_1` etc.—in GDScript, KEY_1 is a global enum constant (Key.KEY_1 = 49). Unqualified KEY_1 works in GDScript 4 (global enums are accessible). Yes.

NOTIFICATION_WM_CLOSE_REQUEST is a global constant of Object. Yes.

One issue: `OS.set("low_processor_usage_mode", ...)`—the OS singleton property "low_processor_usage_mode" exists. OK.

Another: `_win.visibility_changed.connect(...)`—visibility_changed is a signal of Window/Node (Node.visibility_changed is a Node 4.x signal, Window too). OK.

`get_window()` returns Window—the root viewport has a Window. OK.

main.tscn: does ColorRect's "color" property use a Color(...) constructor in the tscn format? In tscn, Color is serialized as `color = Color(0.9, 0.55, 0.15, 1)` (4.x format). Yes.

Label alignment: `horizontal_alignment = 1` (CENTER). OK.

project.godot settings: also add `window/size/transparent=true`, `window/size/transparent_pixel=true`? Risk: if the setting doesn't exist, Godot 4 will warn "Unrecognized key" on load—actually ProjectSettings.save... I think unknown keys in project.godot are silently loaded. But a "4.7" project might have those settings; if the setting names are wrong, the GUI might not be transparent at startup (though it will be set at runtime). Include `window/size/borderless=true`, `window/size/always_on_top=true`, `window/size/transparent=true`, `window/size/transparent_pixel=true`. Even if ignored, runtime will set them. But will warnings like "Unrecognized" be printed to stdout and pollute C1's gate ("no SCRIPT ERROR")? The gate only checks for SCRIPT ERROR; settings warnings aren't script errors. However, for cleanliness: if the key is unknown, Godot might only print an error during editor save, not at load time. Include them; verify from actual output.

Hmm, one more thing: `config/features=PackedStringArray("4.7")`—the features string "4.7" is what a 4.7 project writes (usually it would also include the renderer, e.g., "Forward Plus" or "Metal"). Fine as per plan.

Also, `run/main_scene="res://main.tscn"` is needed.

Do we also want `[rendering] renderer/rendering_method="metal"`? The plan's C2 tests both via CLI flags. Default is unset → macOS 4.7 default is metal? Default rendering_method on macOS in Godot 4.x = "mobile" on mac? Default is "forward_plus"; macOS defaults to metal driver via --rendering-driver... the project setting `renderer/rendering_method` default is "forward_plus"; the driver is separate (`renderer/rendering_driver` default "auto" → metal on macOS). Leave unset; the CLI flag will override. capability.json records the actual value. Good—honest.

README.md contents: GUI manual acceptance checklist (per plan §2 + G-001..004 + TECH_SPIKE §5), keys, C3/C4 commands, matrix template.

Now to write the files. Then execute:

