overlay_window.gd:

```gdscript
extends Node2D

const DRAG_THRESHOLD_PX := 6.0
const SAVE_PATH := "user://spike_window.json"
const REPORT_DIR := "res://report"
const EVIDENCE_DIR := "res://evidence"

@onready var _win: Window = get_window()
@onready var _ship: ColorRect = $Ship
@onready var _status: Label = $Status

var _dragging := false
var _press_pending := false
var _press_global := Vector2.ZERO
var _press_window_pos := Vector2i.ZERO
var _variant := "off"
var _variant_log: Array = []
var _variant_first_seen := {}
var _fps_frames := 0
var _fps_window_start_ms := 0
var _fps_last := -1.0
var _screenshot_count := 0
var _closed_once := false

func _ready() -> void:
	_win.borderless = true
	_win.transparent = true
	_win.always_on_top = true
	_win.mouse_passthrough = false
	Engine.max_fps = 30
	_restore_position()
	_ship.gui_input.connect(_on_ship_gui_input)
	_win.visibility_changed.connect(_on_visibility_changed)
	_fps_window_start_ms = Time.get_ticks_msec()
	_status.text = _status_text()
```

Wait — `_win.transparent = true` at runtime after creation: fine on macOS.

_restore_position: read JSON; on success, clamp x,y to DisplayServer.get_display_safe_area(0); if invalid, keep the project's default position (120,120).

```gdscript
func _restore_position() -> void:
	var pos := Vector2i(120, 120)
	var data: Variant = _read_json(SAVE_PATH)
	if typeof(data) == TYPE_DICTIONARY and data.has("x") and data.has("y"):
		pos = Vector2i(int(data["x"]), int(data["y"]))
	var area: Rect2i = DisplayServer.get_display_safe_area(0)
	if area.size.x >= 1 and area.size.y >= 1:
		pos.x = clampi(pos.x, area.position.x, area.position.x + area.size.x - int(_win.size.x))
		pos.y = clampi(pos.y, area.position.y, area.position.y + area.size.y - int(_win.size.y))
	_win.position = pos
```

Save position (on drag release and on close):

```gdscript
func _save_position() -> void:
	var now := Time.get_datetime_dict_from_system(true)
	var data := {
		"x": _win.position.x, "y": _win.position.y,
		"width": _win.size.x, "height": _win.size.y,
		"display_hint": 0,
		"ts_utc": "%04d-%02d-%02dT%02d:%02d:%02dZ" % [...],
	}
```

Simpler ts: use `Time.get_datetime_string_from_system(true)` → "2026-06-24T12:00:00" (does it include Z? it returns UTC ISO). Fine.

Ship drag handler:

```gdscript
func _on_ship_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			_press_pending = true
			_dragging = false
			_press_global = event.global_position
			_press_window_pos = _win.position
		else:
			if _dragging:
				_save_position()
			_press_pending = false
			_dragging = false
	elif event is InputEventMouseMotion and _press_pending:
		var delta := event.global_position - _press_global
		if not _dragging and delta.length() >= DRAG_THRESHOLD_PX:
			_dragging = true
		if _dragging:
			_win.position = Vector2i(_press_window_pos + Vector2(delta))
```

Key input:

```gdscript
func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		match event.keycode:
			KEY_1: _set_variant("full_passthrough")
			KEY_2: _set_variant("polygon_passthrough")
			KEY_3: _set_variant("off")
			KEY_9: _take_screenshot()
			KEY_Q: _win.release_focus()
```

Hmm KEY_Q is release_focus to allow dragging the transparent area — a good extra, document in README.

_set_variant:

```gdscript
func _set_variant(variant: String) -> void:
	_variant = variant
	var polygon_supported := _window_has_property("mouse_passthrough_polygon")
	var full_supported := _window_has_property("mouse_passthrough")
	var note := ""
	match variant:
		"full_passthrough":
			_win.mouse_passthrough = true
			if polygon_supported:
				_win.mouse_passthrough_polygon = PackedVector2Array()
		"polygon_passthrough":
			if not polygon_supported:
				note = "unsupported: mouse_passthrough_polygon 属性不存在，未生效 (property does not exist, not in effect)"
				_variant = "polygon_unsupported"
			else:
				_win.mouse_passthrough = true
				var size := _win.size
				_win.mouse_passthrough_polygon = PackedVector2Array([
					Vector2.ZERO, Vector2(size.x, 0), Vector2(size.x, size.y), Vector2(0, size.y)])
				note = "多边形=整窗矩形；人工核对船体区是否仍可点击（穿透多边形语义）(polygon = full-window rectangle; manually verify whether the ship area is still clickable (passthrough polygon semantics))"
		"off":
			_win.mouse_passthrough = false
			if polygon_supported:
				_win.mouse_passthrough_polygon = PackedVector2Array()
	_variant_log_append(...)
```

Wait, direct assignment `_win.mouse_passthrough = true` — GDScript property, fine.

Hmm, but if `mouse_passthrough` is absent (older version?), direct assignment becomes a compile error? GDScript compile error: "Invalid set index 'mouse_passthrough'". Direct property assignment to a property that doesn't exist at runtime is a runtime error, not a compile error (Window is a built-in class, static typing — if the property isn't declared at compile time, a typed assignment `Window.mouse_passthrough` might be a compile-time error; it does exist in 4.x so compilation is fine). Godot 4.7.2 has mouse_passthrough (since 4.0), and mouse_passthrough_polygon (since 4.3). To be safe, use `_win.set("mouse_passthrough", true)` (runtime set by StringName) for both. This completely avoids the static compile issue and matches the probe's honesty. Use set/get with StringName.

FPS sampling in _process:

```gdscript
func _process(_delta: float) -> void:
	_fps_frames += 1
	var now := Time.get_ticks_msec()
	var elapsed := now - _fps_window_start_ms
	if elapsed >= 1000:
		_fps_last = float(_fps_frames) * 1000.0 / float(elapsed)
		_fps_frames = 0
		_fps_window_start_ms = now
		_status.text = _status_text()
```

visibility_changed:

```gdscript
func _on_visibility_changed() -> void:
	OS.low_processor_usage_mode = not _win.visible
```

The OS property `low_processor_usage_mode` exists (bool) — but OS.low_processor_usage_mode is a setter on OS? In Godot 4, `OS.low_processor_usage_mode` is a property. Use OS.set("low_processor_usage_mode", ...). Fine.

Screenshot:

```gdscript
func _take_screenshot() -> void:
	DirAccess.make_dir_recursive_absolute(EVIDENCE_DIR)
	_screenshot_count += 1
	var stamp := Time.get_datetime_string_from_system(true, true).replace(":", "").replace("-", "").replace(".", "")
	var path := EVIDENCE_DIR.path_join("spike_%02d_%s.png" % [_screenshot_count, stamp])
	var image := get_viewport().get_texture().get_image()
	var err := image.save_png(path)
	_variant_log_append(...)
```

Close handler:

```gdscript
func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST and not _closed_once:
		_closed_once = true
		_save_position()
		_write_observed_state()
		get_tree().quit()
```

_write_observed_state writes variant_matrix.json + observed_state.json:

variant_matrix.json: array of entries {variant, ts_utc, effective: {mouse_passthrough: get(...), polygon_size, polygon_supported}, fps_at_record, human_observed: ""}. Also include the renderer.

observed_state.json: {engine_version, display_server, rendering_method, headless, window: {position, size, transparent, borderless, always_on_top, mouse_passthrough}, variants: _variant_log, fps_last, screenshots: [...], ts_utc}.

Also, if a GUI run exits without the WM close (unlikely), the report is written on close — fine.

Additionally, periodic report writes every 5 seconds? The plan says "write report/observed_state.json before exit." Keep it on close + also after each variant/screenshot to avoid loss: cheap to write.

status_text: "SPIKE-001 | variant=%s | fps≈%.1f | pos=%d,%d | 1/2/3=穿透模式 9=截图 Q=释放焦点 (passthrough modes / screenshot / release focus)".

Also `_window_has_property` helper.

JSON read/write helpers.

