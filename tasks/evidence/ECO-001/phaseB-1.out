_fp_catch_equal(a: Variant, b: Dictionary) -> bool:
```
	if not (a is Dictionary):
		return false
	var d: Dictionary = a
	return d.size() == 2 and d.get("species_id") == b["species_id"] and d.get("caught_at_utc") == b["caught_at_utc"]
```

_fp_sale_equal(a: Variant, b: Array) -> bool: string array compare:
```
	if not (a is Array): return false
	var x: Array = a
	if x.size() != b.size(): return false
	for i in x.size():
		if x[i] != b[i]: return false
	return true
```

_ledger_reject_code(state, ledger) -> String:
```
	if not (ledger is Dictionary):
		return ERROR_BAD_LEDGER
	var l: Dictionary = ledger
	if l.size() != 2 or not l.has("processed_catches") or not l.has("processed_sales"):
		return ERROR_BAD_LEDGER
	var lc: Variant = l["processed_catches"]
	var ls: Variant = l["processed_sales"]
	if not (lc is Dictionary) or not (ls is Dictionary):
		return ERROR_BAD_LEDGER
	var catches: Dictionary = lc
	var sales: Dictionary = ls
	if catches.size() != state.processed_catch_ids.size() or sales.size() != state.processed_sale_ids.size():
		return ERROR_BAD_LEDGER
	for cid in catches:
		if not (cid is String) or String(cid).is_empty() or not state.processed_catch_ids.has(cid):
			return ERROR_BAD_LEDGER
		var fp: Variant = catches[cid]
		if not (fp is Dictionary):
			return ERROR_BAD_LEDGER
		var f: Dictionary = fp
		if f.size() != 2 or not (f.get("species_id") is String) or String(f.get("species_id")).is_empty() \
				or not FishInstance.timestamp_valid(f.get("caught_at_utc")):
			return ERROR_BAD_LEDGER
	for sid in sales:
		if not (sid is String) or String(sid).is_empty() or not state.processed_sale_ids.has(sid):
			return ERROR_BAD_LEDGER
		var fp2: Variant = sales[sid]
		if not (fp2 is Array) or (fp2 as Array).is_empty():
			return ERROR_BAD_LEDGER
		var seen: Dictionary = {}
		for iid in (fp2 as Array):
			if not (iid is String) or String(iid).is_empty() or seen.has(iid):
				return ERROR_BAD_LEDGER
			seen[iid] = true
			if not _find_basket_fish(state.basket, String(iid)).is_empty():
				return ERROR_BAD_LEDGER  # 账本称已出售但实例仍在篮中：权威状态不一致
	return ""
```

`state.processed_catch_ids.has(cid)` — Array.has ✓.

Also `for cid in catches:` — iterating Dictionary returns keys ✓. Keys of a dict loaded from JSON are Strings; hand-crafted can be non-String → covered.

`_init_reject(code)`:
```
func _init_reject(code: String) -> Dictionary:
	# 初始化失败零副作用：不提交配置，后续命令恒 NOT_INITIALIZED。
	_append_log("initialize", "", code, false, {})
	return {"ok": false, "error_code": code}
```

`_join_reasons(reasons: PackedStringArray) -> String`:
```
	var code := ";".join(reasons)
	if code.is_empty():
		return "gate:UNVERIFIED"
	return code
```

_append_log:
```
func _append_log(action: String, event_id: String, code: String, ok_flag: bool, extra: Dictionary) -> void:
	var entry := {"seq": _log_seq, "action": action, "event_id": event_id, "code": code, "ok": ok_flag}
	var keys := extra.keys()
	keys.sort()
	for key in keys:
		entry[key] = extra[key]
	_log_seq += 1
	transaction_log.append(entry)
