	if not _reject_sell(svc, state, "sale-e7a", ["fish-other"], "CONFLICT_SALE_PARAMS"): return false
	if svc.set_persistence_gate(Callable(self, "_gate_false")).get("ok") != true: return _fail_ret("E7 gate install")
	if not _reject_commit(svc, state, "catch-e7p", "river_carp", _utc(1), "PERSIST_FAILED"): return false
	if not _reject_sell(svc, state, "sale-e7p", ["fish-catch-e7"], "PERSIST_FAILED"): return false
	if state.wallet_gold < 0 or state.wallet_gold != 8: return _fail_ret("E7 gold invariant")
	if int(state.revision) != 2 or state.basket.size() != 0: return _fail_ret("E7 revision/basket drifted")
	return true
