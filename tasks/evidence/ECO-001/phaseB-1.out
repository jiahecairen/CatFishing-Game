sell_fish:

```
func sell_fish(state: GameState, sale_event_id: Variant, instance_ids: Variant) -> Dictionary:
	var reject := _precheck(state, sale_event_id)
	if not reject.is_empty():
		return _sell_fail(sale_event_id, reject)
	if not (instance_ids is Array):
		return _sell_fail(sale_event_id, ERROR_BAD_INSTANCE_LIST)
	var raw: Array = instance_ids
	if raw.is_empty():
		return _sell_fail(sale_event_id, ERROR_BAD_INSTANCE_LIST)
	var dedup: Array = []
	for element in raw:
		if not (element is String) or String(element).is_empty():
			return _sell_fail(sale_event_id, ERROR_BAD_INSTANCE_LIST)
		if not dedup.has(element):
			dedup.append(element)
	var sid := String(sale_event_id)
	var fp: Array = dedup.duplicate(true)
	fp.sort()  # 实例顺序不影响指纹（review 条件 2）
	if _sale_ledger.has(sid) or state.processed_sale_ids.has(sid):
		if not _sale_ledger.has(sid):
			return _sell_fail(sid, ERROR_CONFLICT_SALE_PARAMS)
		if _fp_sale_equal(_sale_ledger[sid], fp):
			return _sell_fail(sid, ERROR_ALREADY_APPLIED, true)
		return _sell_fail(sid, ERROR_CONFLICT_SALE_PARAMS)
	var gold_added := 0
	for iid in dedup:
		var fish := _find_fish(state.basket, String(iid))
		if fish.is_empty():
			return _sell_fail(sid, ERROR_UNKNOWN_INSTANCE)
		var price := int(fish["sale_price_at_catch"])  # 校验已保证非负整数值
		if price > INT64_MAX - gold_added:
			return _sell_fail(sid, ERROR_GOLD_OVERFLOW)
		gold_added += price
	if state.wallet_gold > INT64_MAX - gold_added:
		return _sell_fail(sid, ERROR_GOLD_OVERFLOW)
	var next := _state_snapshot(state)
	next["wallet_gold"] = state.wallet_gold + gold_added
	next["basket"] = _filter_basket(next["basket"], dedup)
	next["processed_sale_ids"].append(sid)
	next["revision"] = int(next["revision"]) + 1
	var ledger := snapshot_ledger()
	ledger["processed_sales"][sid] = fp.duplicate(true)
	if not _persist({"next_state": next, "ledger": ledger}):
		return _sell_fail(sid, ERROR_PERSIST_FAILED)
	state.basket = _filter_basket(state.basket, dedup)
	state.wallet_gold += gold_added
	state.processed_sale_ids.append(sid)
	state.revision += 1
	_sale_ledger[sid] = fp.duplicate(true)
	return _sell_fail(sid, "", true, gold_added)
```
_sell_fail(sale_event_id, code, ok_flag := false, gold_added := 0) — name is misleading; call it _sell_result. Fine.

