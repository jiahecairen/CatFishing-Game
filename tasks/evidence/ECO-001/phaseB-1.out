```
func _persist(next_state: Dictionary, ledger: Dictionary) -> bool:
	if not _gate_set:
		return true  # 默认恒真门（内存模式）
	if not _gate.is_valid():
		return false  # 失效/报错 Callable：不调用，直接 fail-closed
