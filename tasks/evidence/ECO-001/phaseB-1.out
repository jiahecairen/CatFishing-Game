```
func restore_ledger(state: GameState, ledger: Variant) -> Dictionary:
	if not _initialized:
		_append_log("restore_ledger", "", ERROR_NOT_INITIALIZED, false, {})
		return _fail_ledger(ERROR_NOT_INITIALIZED)
	if state == null: ... NULL_GAME_STATE
	var state_code := _validate_state(state) ...
	var code := _ledger_reject_code(state, ledger)  # "" if OK
	if not code.is_empty(): reject
	# 全部校验通过才一次性替换内部账本（规范化 sale 指纹为去重升序）
	var l: Dictionary = ledger
	_catch_ledger = (l["processed_catches"] as Dictionary).duplicate(true)
	_sale_ledger = {}
	var ls: Dictionary = l["processed_sales"]
	for sid in ls:
		var fp: Array = (ls[sid] as Array).duplicate(true)
		fp.sort()
		_sale_ledger[sid] = fp
	_append_log("restore_ledger", "", "", true, {})
	return {"ok": true, "code": ""}
```
