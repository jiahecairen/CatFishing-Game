_validate_state returns "" | "BAD_STATE" | "BAD_PRICE":

```
func _validate_state(state: GameState) -> String:
	if state.save_version < 1 or state.revision < 0 or state.wallet_gold < 0 or state.basket_capacity < 1:
		return ERROR_BAD_STATE
	var basket: Variant = state.basket
	if not (basket is Array) or basket.size() > state.basket_capacity:
		return ERROR_BAD_STATE
	var seen_ids: Dictionary = {}
	var seen_sources: Dictionary = {}
	for element in (basket as Array):
		if not (element is Dictionary):
			return ERROR_BAD_STATE
		if FishInstance.price_invalid(element):
			return ERROR_BAD_PRICE
		if not FishInstance.validate(element):
			return ERROR_BAD_STATE
		var e: Dictionary = element
		var iid := String(e["instance_id"])
		var source := String(e["source_event_id"])
		if seen_ids.has(iid) or seen_sources.has(source):
			return ERROR_BAD_STATE
		seen_ids[iid] = true
		seen_sources[source] = true
	for ids in [state.processed_catch_ids, state.processed_sale_ids]:
		var seen: Dictionary = {}
		for element in (ids as Array):
			if not (element is String) or String(element).is_empty() or seen.has(element):
				return ERROR_BAD_STATE
			seen[element] = true
	return ""
```
`state.basket.size() > state.basket_capacity` — both int. `basket` is Variant Array after check — `basket.size()` on Variant: GDScript dynamic call, OK.

Hmm — `for element in (basket as Array)` — if basket is Variant… after `basket is Array` check, `as` cast is fine.

commit_catch full:

```
## 捕获落账：先全量校验 → 构造 next-state → 持久化门 → 一次性发布（INTERFACES §5/§6）。
## 参数以 Variant 收参：非法类型必须返回稳定错误码而非引擎调用错误（plan §4）。
func commit_catch(state: GameState, catch_event_id: Variant, species_id: Variant, caught_at_utc: Variant) -> Dictionary:
	var reject := _precheck(state, catch_event_id)
	if not reject.is_empty():
		return _commit_fail(catch_event_id, reject)
	if not (species_id is String) or not _catalog_by_id.has(String(species_id)):
		return _commit_fail(catch_event_id, ERROR_UNKNOWN_SPECIES)
	if not FishInstance.timestamp_valid(caught_at_utc):
		return _commit_fail(catch_event_id, ERROR_BAD_TIMESTAMP)
	var cid := String(catch_event_id)
	var fp := _catch_fp(String(species_id), String(caught_at_utc))
	if _catch_ledger.has(cid) or state.processed_catch_ids.has(cid):
		if not _catch_ledger.has(cid):
			# state 声称已处理但无指纹可核验 → 无法证明同参，按冲突 fail-closed（不以 AlreadyApplied 掩盖）
			return _commit_fail(cid, ERROR_CONFLICT_CATCH_PARAMS)
		if _fp_catch_equal(_catch_ledger[cid], fp):
			return _commit_fail(cid, ERROR_ALREADY_APPLIED, true, FishInstance.ID_PREFIX + cid)
		return _commit_fail(cid, ERROR_CONFLICT_CATCH_PARAMS)
	if state.basket.size() >= state.basket_capacity:
		return _commit_fail(cid, ERROR_BASKET_FULL)
	var fish := FishInstance.make(cid, _catalog_by_id[String(species_id)], String(caught_at_utc))
	if not FishInstance.validate(fish):
		return _commit_fail(cid, ERROR_BAD_STATE)  # 理论不可达：make 产出恒合法；防御性 fail-closed
	var next := _state_snapshot(state)
	next["basket"].append(fish.duplicate(true))
	next["processed_catch_ids"].append(cid)
	next["revision"] = int(next["revision"]) + 1
	var ledger := snapshot_ledger()
	ledger["processed_catches"][cid] = fp.duplicate(true)
	if not _persist({"next_state": next, "ledger": ledger}):
		return _commit_fail(cid, ERROR_PERSIST_FAILED)
	# —— 门成功：一次性发布到唯一权威状态 ——
	state.basket.append(fish)
	state.processed_catch_ids.append(cid)
	state.revision += 1
	_catch_ledger[cid] = fp.duplicate(true)
	return _commit_fail(cid, "", true, String(fish["instance_id"]), {"gold_added_untouched": true})?
```
