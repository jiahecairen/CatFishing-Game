E10:

```
func _e10() -> bool:
	# false gate
	var s1: EconomyService = _svc()
	var state := GameState.new()
	# first, one fish with the default always-true gate
	if not _apply_commit(s1, state, "catch-e10", "river_carp", _utc(1)): return false
	if s1.set_persistence_gate(Callable(self, "_gate_false")).get("ok") != true: fail
	if not _reject_commit(s1, state, "catch-e10b", "river_carp", _utc(2), "PERSIST_FAILED"): return false
	if not _reject_sell(s1, state, "sale-e10", ["fish-catch-e10"], "PERSIST_FAILED"): return false
	if state.basket.size() != 1 or state.wallet_gold != 0 or state.revision != 1: fail
	# ledger unchanged: internal ledger only adds on publish — snapshot_ledger unchanged (no new id)
	var ledger: Dictionary = s1.snapshot_ledger()
	if (ledger["processed_catches"] as Dictionary).has("catch-e10b"): fail
	# non-bool gate
	var s2: EconomyService = _svc()
	s2.set_persistence_gate(Callable(self, "_gate_nonbool"))
	if not _reject_commit(s2, GameState.new(), "catch-e10c", "river_carp", _utc(1), "PERSIST_FAILED"): return false
	# invalid/erroring Callables (is_valid()==false; fail-closed, never actually called)
	var s3: EconomyService = _svc()
	s3.set_persistence_gate(Callable())
	if not _reject_commit(s3, GameState.new(), "catch-e10d", "river_carp", _utc(1), "PERSIST_FAILED"): return false
	s3.set_persistence_gate(Callable(GameState.new(), "definitely_missing_method"))
	if not _reject_sell(s3, GameState.new(), "sale-e10d", ["fish-x"], "PERSIST_FAILED"): return false
	# poison gate: mutates copies then returns true — publication must not be polluted
	var s4: EconomyService = _svc()
	s4.set_persistence_gate(Callable(self, "_gate_poison"))
	var state2 := GameState.new()
	var r: Dictionary = s4.commit_catch(state2, "catch-e10e", "golden_trout", _utc(1))
	if r.get("ok") != true or String(r["code"]) != "": fail
	if _gate_seen_basket != 1: return _fail_ret("E10 gate did not receive full next_state (basket=%d)" % _gate_seen_basket)
	if _gate_seen_catch_ids != 1: fail
	if state2.basket.size() != 1 or state2.wallet_gold != 0 or state2.revision != 1: fail
	var ledger2: Dictionary = s4.snapshot_ledger()
	if not (ledger2["processed_catches"] as Dictionary).has("catch-e10e"): fail
	# poison gate's sell-side publication also uncontaminated
	var rs: Dictionary = s4.sell_fish(state2, "sale-e10e", ["fish-catch-e10e"])
	if rs.get("ok") != true or int(rs["gold_added"]) != 32 or state2.wallet_gold != 32 or state2.basket.size() != 0: fail
	return true
```
_gate_poison also sets _gate_seen_catch_ids. Also poison sets wallet 777777 on a copy — assert state2.wallet_gold == 0 after commit, == 32 after sell ✓.

_gate_false's signature: `func _gate_false(_payload: Dictionary) -> bool: return false` ✓.

E11:

```
func _e11() -> bool:
	var svc1: EconomyService = _svc()
	var state := GameState.new()
	if not _apply_commit(svc1, state, "catch-e11", "river_carp", _utc(1)): return false
	if not _apply_sell(svc1, state, "sale-e11", ["fish-catch-e11"], 8): return false
	var ledger := svc1.snapshot_ledger()
	# snapshot_ledger returns deep copy: mutating the copy doesn't affect the internal ledger
	(ledger["processed_catches"] as Dictionary).erase("catch-e11")
	var check: Dictionary = svc1.snapshot_ledger()
	if not (check["processed_catches"] as Dictionary).has("catch-e11"): return _fail_ret("E11 snapshot not a deep copy")
	var svc2: EconomyService = _svc()
	var restore: Dictionary = svc2.restore_ledger(state, check)
	if restore.get("ok") != true: return _fail_ret("E11 restore good ledger")
	# same id/same params → ALREADY_APPLIED (idempotency across instances)
	var rc: Dictionary = svc2.commit_catch(state, "catch-e11", "river_carp", _utc(1))
	if rc.get("ok") != true or String(rc["code"]) != "ALREADY_APPLIED" or String(rc["instance_id"]) != "fish-catch-e11": fail
	# same id/different params → conflict, zero side effects
	if not _reject_commit(svc2, state, "catch-e11", "golden_trout", _utc(1), "CONFLICT_CATCH_PARAMS"): return false
	var rs: Dictionary = svc2.sell_fish(state, "sale-e11", ["fish-catch-e11"])
	if rs.get("ok") != true or String(rs["code"]) != "ALREADY_APPLIED" or int(rs["gold_added"]) != 0: fail
	if not _reject_sell(svc2, state, "sale-e11", ["fish-x"], "CONFLICT_SALE_PARAMS"): return false
	if state.wallet_gold != 8 or state.revision != 2 or state.basket.size() != 0: fail
	# bad ledger fail-closed: extra key / missing key / fingerprint shape broken / sale fingerprint references a fish still in basket
	var bad1: Dictionary = svc1.snapshot_ledger()
	bad1["extra"] = 1
	if not _reject_restore(svc2, state, bad1, "BAD_LEDGER"): return false
	var bad2 := {"processed_catches": {}, "processed_sales": {}}  # state has processed ids but ledger is empty → mismatch
	if not _reject_restore(svc2, state, bad2, "BAD_LEDGER"): return false
	var bad3: Dictionary = svc1.snapshot_ledger()
	(bad3["processed_catches"] as Dictionary)["catch-bogus"] = {"species_id": "river_carp", "caught_at_utc": _utc(1)}
	if not _reject_restore(svc2, state, bad3, "BAD_LEDGER"): return false
	var bad4: Dictionary = svc1.snapshot_ledger()
	(bad4["processed_catches"] as Dictionary)["catch-e11"] = {"species_id": "river_carp"}  # fingerprint shape broken
	if not _reject_restore(svc2, state, bad4, "BAD_LEDGER"): return false
	# sale fingerprint references a fish still in basket → BAD_LEDGER
	var svc3: EconomyService = _svc()
	var state3 := GameState.new()
	if not _apply_commit(svc3, state3, "catch-e11z", "river_carp", _utc(1)): return false
	state3.processed_sale_ids.append("sale-e11z")  # forge "already sold" in the test but fish is still in basket
	var bad5: Dictionary = svc3.snapshot_ledger()
	bad5["processed_sales"]["sale-e11z"] = ["fish-catch-e11z"]
	if not _reject_restore(svc3, state3, bad5, "BAD_LEDGER"): return false
	# restore failure means zero side effects: svc2's ledger is still usable (re-restore the good ledger and idempotency recovers)
	var again: Dictionary = svc2.restore_ledger(state, svc1.snapshot_ledger())
	if again.get("ok") != true: return _fail_ret("E11 restore after failures must still succeed")
	var rc2: Dictionary = svc2.commit_catch(state, "catch-e11", "river_carp", _utc(1))
	if rc2.get("ok") != true or String(rc2["code"]) != "ALREADY_APPLIED": fail
	return true
```
_reject_restore(svc, state, ledger, want): zero side effects + code.

Wait, bad2's restore check: ledger is empty but state.processed_catch_ids has 1 entry → size mismatch → BAD_LEDGER ✓.

One more point about bad1: ledger with 3 keys → BAD_LEDGER ✓.

Also, `_reject_commit` against svc2's CONFLICT: state.processed_catch_ids has "catch-e11", and svc2._catch_ledger has it too (after restore) → fingerprint compare → different species → CONFLICT ✓.

