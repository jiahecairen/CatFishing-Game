```gdscript
class_name EconomyService
extends RefCounted
# ECO-001：经济事务服务（INTERFACES §5/§6、ARCHITECTURE §2/§5、SDD V01-E01/E02、SDD-143/172/173、
# tasks/evidence/ECO-001/plan.md §4 + review.md 强制条件）。
# 不变量：
# - 纯 RefCounted 数据层：无 Node/_process/_physics_process、无 Engine 帧/时间 API、
#   不读写 user://、无任何文件写入（持久化门是注入点，本票默认恒真门）。
# - GameState 是唯一经济权威：本服务经引用一次性提交 wallet_gold/basket/processed_*_ids/
#   revision；任何失败路径对 GameState 零副作用（先全量校验 → 构造 next 值 → 门 → 发布）。
# - 幂等：同 catch_event_id ≤1 条鱼、同 sale_event_id ≤1 次加币；同 ID 异参 →
#   CONFLICT_* 并记入内存 transaction_log，不以 AlreadyApplied 掩盖（INTERFACES §5）。
# - 售鱼清单按 INTERFACES §5 去重计价；同一 sale ID 的实例顺序不影响参数指纹。
# - 经济参数（20/60s、30FPS、容量 10、鱼价/权重）只读取不修改。
# - 命令同步、单线程、一次一条（同一命令队列串行处理的接口形状；上层不得旁路本服务）。

const ERROR_NOT_INITIALIZED := "NOT_INITIALIZED"
const ERROR_NULL_GAME_STATE := "NULL_GAME_STATE"
const ERROR_BAD_STATE := "BAD_STATE"
const ERROR_BAD_EVENT_ID := "BAD_EVENT_ID"
const ERROR_UNKNOWN_SPECIES := "UNKNOWN_SPECIES"
const ERROR_BAD_TIMESTAMP := "BAD_TIMESTAMP"
const ERROR_BASKET_FULL := "BASKET_FULL"
const ERROR_ALREADY_APPLIED := "ALREADY_APPLIED"
const ERROR_CONFLICT_CATCH := "CONFLICT_CATCH_PARAMS"
const ERROR_CONFLICT_SALE := "CONFLICT_SALE_PARAMS"
const ERROR_UNKNOWN_INSTANCE := "UNKNOWN_INSTANCE"
const ERROR_BAD_INSTANCE_LIST := "BAD_INSTANCE_LIST"
const ERROR_BAD_PRICE := "BAD_PRICE"
const ERROR_GOLD_OVERFLOW := "GOLD_OVERFLOW"
const ERROR_PERSIST_FAILED := "PERSIST_FAILED"
const ERROR_BAD_LEDGER := "BAD_LEDGER"  # restore_ledger 专用（坏形状/与 processed ids 不一致）

const INT64_MAX := 9223372036854775807

var transaction_log: Array = []
var _initialized := false
var _runtime: Dictionary = {}
var _catalog_by_id: Dictionary = {}
var _catch_ledger: Dictionary = {}  # catch_event_id -> {"species_id":String, "caught_at_utc":String}
var _sale_ledger: Dictionary = {}   # sale_event_id -> Array[String]（去重+排序后的实例清单指纹）
var _gate: Callable = Callable()
var _gate_set := false
var _log_seq := 0
```

initialize:
```
func initialize(catalog: Dictionary, runtime: Dictionary) -> Dictionary:
	if not ConfigGate.can_start_economy(catalog, runtime):
		var reasons := ConfigGate.blocked_reasons(catalog, runtime)
		var code := ";".join(reasons)
		if code.is_empty():
			code = "gate:UNVERIFIED"
		_append_log("initialize", code, "")
		return {"ok": false, "error_code": code}
	var by_id := {}
	for element in (catalog["species"] as Array):
		if not (element is Dictionary):
			# can_start_economy 只保证 species 是非空数组；逐元素防御性再校验（fail-closed）。
			_append_log("initialize", "catalog:BAD_SHAPE", "")
			return {"ok": false, "error_code": "catalog:BAD_SHAPE"}
		var entry: Dictionary = element
		if not (entry.get("id") is String) or String(entry["id"]).is_empty() \
				or not (entry.has("base_price")) or not FishInstance.price_valid(entry["base_price"]):
			_append_log("initialize", "catalog:BAD_SHAPE", "")
			return {"ok": false, "error_code": "catalog:BAD_SHAPE"}
		by_id[String(entry["id"])] = entry.duplicate(true)
	_catalog_by_id = by_id
	_runtime = runtime.duplicate(true)
	_initialized = true
	_append_log("initialize", "", "")
	return {"ok": true, "error_code": ""}
```
Wait: species entry missing "id" → entry.get("id") is null → not (null is String) → true → reject. OK. Note: `entry["base_price"]` if missing → runtime error! Guard `entry.has("base_price")` first, short-circuit — GDScript `or` short-circuits. `not (entry.has("base_price")) or not FishInstance.price_valid(entry["base_price"])` — fine.

set_persistence_gate:
```
## 注入持久化门：gate(payload: Dictionary) -> bool；仅当**正常返回布尔 true** 才发布。
## 返回 false、非 bool、或 Callable 失效/报错（is_valid()==false）一律 PERSIST_FAILED。
## payload = {"next_state": 完整 next GameState 深拷贝, "ledger": 提交后指纹账本深拷贝}，
## 门对副本的任何修改不影响实时 GameState / 内部账本（review 条件 4）。
## 传入失效 Callable（含 Callable()）＝安装"永久拒绝门"（fail-closed 安全方向）；
## 全新实例默认恒真门（内存模式）。本票零写盘，SAVE-001 在此注入 SaveService 原子写盘。
func set_persistence_gate(gate: Callable) -> Dictionary:
	_gate = gate
	_gate_set = true
	_append_log("set_persistence_gate", "", "")
	return {"ok": true, "code": ""}
```

commit_catch(state, catch_event_id: Variant, species_id: Variant, caught_at_utc: Variant):

```
func commit_catch(state: GameState, catch_event_id: Variant, species_id: Variant, caught_at_utc: Variant) -> Dictionary:
	var reject := _precheck(state, catch_event_id)  # returns "" or NOT_INIT/NULL/BAD_STATE/BAD_PRICE/BAD_EVENT_ID
	if reject: fail return
	# species
	if not (species_id is String) or not _catalog_by_id.has(String(species_id)):
		_fail("commit_catch", catch_event_id, ERROR_UNKNOWN_SPECIES)
	if not FishInstance.timestamp_valid(caught_at_utc):
		... BAD_TIMESTAMP
	var cid := String(catch_event_id)
	var in_ledger := _catch_ledger.has(cid)
	var in_state: bool = state.processed_catch_ids.has(cid)
	if in_ledger or in_state:
		if not in_ledger:
			# state 声称已处理但指纹账本无据可查 → 无法证明同参，fail-closed 视为冲突
			return conflict CONFLICT_CATCH_PARAMS
		var fp := _catch_fp(String(species_id), String(caught_at_utc))
		if _catch_fp_equal(_catch_ledger[cid], fp):
			return {ok:true, code: ALREADY_APPLIED, instance_id: FishInstance.ID_PREFIX + cid}  (logged)
		return CONFLICT_CATCH_PARAMS
	if state.basket.size() >= int(state.basket_capacity):
		BASKET_FULL
	var entry: Dictionary = _catalog_by_id[String(species_id)]
	var fish := FishInstance.make(cid, entry, String(caught_at_utc))
	var next := _state_snapshot(state)
	next["basket"].append(fish.duplicate(true))
	next["processed_catch_ids"].append(cid)
	next["revision"] = int(next["revision"]) + 1
	var ledger := snapshot_ledger()
	ledger["processed_catches"][cid] = _catch_fp(...).duplicate(true)  hmm _catch_fp already builds a fresh dict
	if not _persist(next, ledger):
		return PERSIST_FAILED
	# 发布（门成功后才触碰权威状态，INTERFACES §6）
	state.basket.append(fish)
	state.processed_catch_ids.append(cid)
	state.revision += 1
	_catch_ledger[cid] = fp
	log success
	return {"ok": true, "code": "", "instance_id": fish["instance_id"]}
```

Wait, ordering between idempotency and timestamp validation: retry of same catch with bad timestamp — validate timestamp first, then fingerprint check. OK.

Wait ordering between species/timestamp validation and BAD_EVENT_ID: precheck handles event ID. Also: species validated before ledger — a retry with different species → fp compare handles species diff → CONFLICT. But species not in catalog → UNKNOWN_SPECIES before CONFLICT — acceptable? Plan E5: same catch ID different species — but a test would use another valid species (silver_perch). OK.

_precheck(state, event_id) -> String:
```
if not _initialized: return NOT_INITIALIZED
if state == null: return NULL_GAME_STATE
var sc := _validate_state(state): if sc: return sc
if not (catch_event_id is String) or empty: return BAD_EVENT_ID
```
Note: _validate_state includes BAD_PRICE.

sell_fish(state, sale_event_id: Variant, instance_ids: Variant):
```
if not _initialized: NOT_INITIALIZED
if state == null: NULL_GAME_STATE
var sc := _validate_state(state); if sc: return
if not (sale_event_id is String) or empty: BAD_EVENT_ID
if not (instance_ids is Array): BAD_INSTANCE_LIST
var raw: Array = instance_ids
if raw.is_empty(): BAD_INSTANCE_LIST
var dedup := []
for element in raw:
	if not (element is String) or String(element).is_empty(): BAD_INSTANCE_LIST
	if not dedup.has(element): dedup.append(element)
var sid := String(sale_event_id)
var fp_ids := dedup.duplicate(true); fp_ids.sort()
if _sale_ledger.has(sid) or state.processed_sale_ids.has(sid):
	if not _sale_ledger.has(sid): CONFLICT_SALE_PARAMS
	if _sale_ledger[sid] == fp_ids → String array == is element-wise? Godot 4 Variant array `==`: I think it's identity for arrays. Use _str_array_equal helper.
		→ ALREADY_APPLIED ok gold_added 0
	else CONFLICT_SALE_PARAMS
var prices := {}  # instance_id -> price; and existence
for iid in dedup:
	var fish := _find_fish(state.basket, iid)
	if fish.is_empty(): UNKNOWN_INSTANCE
	var price := int(fish["sale_price_at_catch"])  # price_valid already ensured non-negative int
	prices[iid] = price
# 溢出（金币恒非负整数，禁止绕回）
var gold_added := 0
for iid in dedup (or prices.values):
	var p: int = prices[iid]
	if p > INT64_MAX - gold_added: GOLD_OVERFLOW
	gold_added += p
if state.wallet_gold > INT64_MAX - gold_added: GOLD_OVERFLOW
var next := _state_snapshot(state)
next["wallet_gold"] = state.wallet_gold + gold_added
next["basket"] = _filter_sold(next["basket"], dedup)
next["processed_sale_ids"].append(sid)
next["revision"] = int(next["revision"]) + 1
ledger := snapshot_ledger(); ledger["processed_sales"][sid] = fp_ids.duplicate(true)
if not _persist(next, ledger): PERSIST_FAILED
发布: state.basket = _filter_sold(state.basket, dedup); state.wallet_gold += gold_added; state.processed_sale_ids.append(sid); state.revision += 1; _sale_ledger[sid] = fp_ids.duplicate(true)
return {ok:true, code:"", gold_added}
```

_validate_state(state: GameState) -> String:
```
if state.wallet_gold < 0 or state.revision < 0 or int(state.basket_capacity) < 1 or int(state.save_version) < 1: BAD_STATE
var basket: Variant = state.basket
if not (basket is Array): BAD_STATE
if basket.size() > int(state.basket_capacity): BAD_STATE
var seen_ids := {}, seen_src := {}
for element in basket:
	if not (element is Dictionary): BAD_STATE
	if FishInstance.price_invalid(element): BAD_PRICE
	if not FishInstance.validate(element): BAD_STATE
	var e: Dictionary = element
	var iid := String(e["instance_id"])
	var src := String(e["source_event_id"])
	if seen_ids.has(iid) or seen_src.has(src): BAD_STATE
	seen_ids[iid] = true; seen_src[src] = true
for arr_name in ...: processed arrays: all elements non-empty String and unique, else BAD_STATE
```
Note: state.wallet_gold is typed int so < 0 comparison is fine.

Also processed ids unique (uniqueItems in schema).

snapshot_ledger -> Dictionary: `{"processed_catches": _catch_ledger.duplicate(true), "processed_sales": _sale_ledger.duplicate(true)}`.

restore_ledger(state: GameState, ledger: Variant) -> Dictionary:
```
if not _initialized: NOT_INITIALIZED (log)
if state == null: NULL_GAME_STATE
var sc := _validate_state(state) → return if bad
if not (ledger is Dictionary): BAD_LEDGER
var l: Dictionary = ledger
if l.size() != 2 or not l.has("processed_catches") or not l.has("processed_sales"): BAD_LEDGER
lc := l["processed_catches"]; ls := l["processed_sales"]
if not (lc is Dictionary) or not (ls is Dictionary): BAD_LEDGER
if lc.size() != state.processed_catch_ids.size() or ls.size() != state.processed_sale_ids.size(): BAD_LEDGER
for cid in lc:
	if not (cid is String) or empty: BAD_LEDGER
	if not (state.processed_catch_ids as Array).has(cid): BAD_LEDGER
	var fp: Variant = lc[cid]
	if not (fp is Dictionary): BAD_LEDGER
	var f: Dictionary = fp
	if f.size() != 2 or not (f.get("species_id") is String) or empty species… or not timestamp_valid(f.get("caught_at_utc")): BAD_LEDGER
for sid in ls:
	similar: keys are non-empty and in state.processed_sale_ids; fp is Array of non-empty unique Strings, sorted? (normalize to sorted anyway; but ledger shape requires sorted for determinism? Be lenient: sort on restore)
	Also: sold instance IDs should not exist in basket: for each iid in fp: if basket has iid → BAD_LEDGER
Duplicate-check for state processed id arrays: already in _validate_state.
# 成功：原子替换内部账本
_catch_ledger = (lc as Dictionary).duplicate(true)
_sale_ledger = {}
for sid in ls: _sale_ledger[sid] = (ls[sid] as Array).duplicate(true) after sort
log; return {ok:true, code:""}
```
Hmm — on failure, no changes to ledger. Build into temp first, assign at end. OK.

Note: restore requires keys ⊆ state processed ids and sizes equal → set equivalence.

get_transaction_log() -> Array: transaction_log.duplicate(true).

_append_log(action, code, event_id, extra := {}):
```
var entry := {"seq": _log_seq, "action": action, "event_id": event_id, "code": code, "at_clock": _monotonic?}
```
No clock in economy — no VirtualClock injection in plan. Skip at_clock. Add "ok": bool. Plus details.

```
func _append_log(action: String, code: String, event_id: String, ok_flag: bool, extra := {}) -> void:
	var entry := {"seq": _log_seq, "action": action, "event_id": event_id, "code": code, "ok": ok_flag}
	var keys := extra.keys(); keys.sort()
	for key in keys: entry[key] = extra[key]
	_log_seq += 1
	transaction_log.append(entry)
```

