	if good.keys().size() != 5 or int(good["sale_price_at_catch"]) != 8: fail
	if String(good["source_event_id"]) != "catch-e0": fail
	# timestamps
	for bad in ["", "2026-11-11T08:30:00", "2026-13-01T00:00:00Z", "2026-02-30T00:00:00Z", "2026-11-11T24:00:00Z", "2026-11-11T08:60:00Z", "2026-11-11 08:30:00Z", "not-a-time", 42, null]:
		if FishScript.timestamp_valid(bad): fail
	if not FishScript.timestamp_valid("2024-02-29T23:59:59Z"): fail  # leap year
	if FishScript.timestamp_valid("2025-02-29T00:00:00Z"): fail  # non-leap year
	# price
	for bad_price in [-1, 8.5, "8", null, true, 42]:  # wait, true is bool — is price_valid(true)? bool isn't int → false → invalid ✓
		if FishScript.price_valid(bad_price): fail
	if not FishScript.price_valid(0) or not FishScript.price_valid(8) or not FishScript.price_valid(8.0): fail
	# price_invalid distinguishes BAD_PRICE vs BAD_STATE shapes
	var bad_price_fish := good.duplicate(true); bad_price_fish["sale_price_at_catch"] = -5
	if not FishScript.price_invalid(bad_price_fish): fail
	var missing := good.duplicate(true); missing.erase("sale_price_at_catch")
	if FishScript.price_invalid(missing): fail  # missing key belongs to BAD_STATE, not BAD_PRICE
	return true
```
