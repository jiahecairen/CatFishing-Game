E8:

```
func _e8() -> bool:
	var parts := _make_fsm(4002)
	if parts.is_empty(): return _fail_ret("E8 setup")
	var fsm = parts[0]
	var svc: EconomyService = _svc()
	if svc == null: return _fail_ret("E8 svc")
	var state := GameState.new()
	var rc: Dictionary = fsm.request_cast(state)
	if rc.get("ok") != true: return _fail_ret("E8 cast")
	fsm.tick_effective(5.0); fsm.tick_effective(200.0); fsm.tick_effective(1.0); fsm.tick_effective(1.0)
	if fsm.get_state() != FsmScript.State.SETTLEMENT: return _fail_ret("E8 must be SETTLEMENT")
	var cand: Dictionary = fsm.produce_catch_candidate()
	if cand.get("ok") != true: return _fail_ret("E8 candidate")
	var catch_id := String(cand["catch_event_id"])
	if catch_id != String(rc["catch_event_id"]): return _fail_ret("E8 candidate event mismatch")
	var res: Dictionary = svc.commit_catch(state, catch_id, String(cand["species_id"]), "2026-11-11T16:00:00Z")
	if res.get("ok") != true or String(res["code"]) != "": return _fail_ret("E8 commit")
	if state.basket.size() != 1: return _fail_ret("E8 basket")
	var fish: Dictionary = state.basket[0]
	if String(fish["instance_id"]) != "fish-" + catch_id: return _fail_ret("E8 instance_id derivation")
	if String(fish["source_event_id"]) != catch_id: return _fail_ret("E8 source_event_id")
	if String(fish["species_id"]) != String(cand["species_id"]): return _fail_ret("E8 species mismatch")
	if int(fish["sale_price_at_catch"]) != int((cand["weight_snapshot"] as Dictionary)["base_price"]): fail
	if String(fish["caught_at_utc"]) != "2026-11-11T16:00:00Z": return _fail_ret("E8 utc snapshot preserved")
	if not FishScript.validate(fish): return _fail_ret("E8 fish schema invalid")
	var ack: Dictionary = fsm.ack_settlement(catch_id, true)
	if ack.get("ok") != true or String(ack["next_state"]) != "IDLE": return _fail_ret("E8 ack IDLE")
	var rc2: Dictionary = fsm.request_cast(state)
	if rc2.get("ok") != true or String(rc2["catch_event_id"]) != catch_id: return _fail_ret("E8 re-cast must reuse new unique event id")
	return true
```
rc2's id differs from catch_id: RNG advances → new id; assert `!=` catch_id.

