_make_fsm(seed):
```
func _make_fsm(seed_value: int) -> Array:
	var rng: DeterministicRng = RngScript.new()
	var clock: VirtualClock = ClockScript.new()
	if rng.set_seed(seed_value).get("ok") != true:
		return []
	var fsm: FishingStateMachine = FsmScript.new()
	if fsm.initialize(_catalog, _runtime, rng, clock, {}).get("ok") != true:
		return []
	return [fsm, rng, clock]
```

_snap / _deep_eq / _apply_commit / _apply_sell / _reject_commit / _reject_sell / _reject_restore / _utc / gates / _fail_ret.

_deep_eq:
```
func _deep_eq(a: Variant, b: Variant) -> bool:
	if (a is Array) and (b is Array):
		var la: Array = a
		var lb: Array = b
		if la.size() != lb.size(): return false
		for index in la.size():
			if not _deep_eq(la[index], lb[index]): return false
		return true
	if (a is Dictionary) and (b is Dictionary):
		var da: Dictionary = a
		var db: Dictionary = b
		if da.size() != db.size(): return false
		for key in da:
			if not db.has(key) or not _deep_eq(da[key], db[key]): return false
		return true
	if (a is Array) != (b is Array): return false
	if (a is Dictionary) != (b is Dictionary): return false
	return a == b
```
Note: comparing int 8 vs float 8.0 → true; OK (snapshots come from the same source anyway).

_apply_commit:
```
func _apply_commit(svc, state, catch_id: String, species_id: String, utc: String) -> bool:
	var r: Dictionary = svc.commit_catch(state, catch_id, species_id, utc)
	if r.get("ok") != true or String(r["code"]) != "":
		return _fail_ret("apply commit %s -> %s" % [catch_id, str(r)])
	return true
```
_apply_sell(svc, state, sale_id, ids, want_gold):
```
	var r: Dictionary = svc.sell_fish(state, sale_id, ids)
	if r.get("ok") != true or String(r["code"]) != "" or int(r["gold_added"]) != want_gold:
		return _fail_ret("apply sell %s -> %s" % [sale_id, str(r)])
	return true
```
_reject_restore(svc, state, ledger, want):
```
	var before := _snap(state)
	var r: Dictionary = svc.restore_ledger(state, ledger)
	if r.get("ok") != false or String(r["code"]) != want:
		return _fail_ret("restore expected %s got %s" % [want, str(r)])
	if not _deep_eq(before, _snap(state)):
		return _fail_ret("restore mutated state")
	return true
```

