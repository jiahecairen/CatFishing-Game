	rich.wallet_gold = INT64_MAX
	if not _reject_sell(svc, rich, "sale-rich", ["fish-catch-rich"], "GOLD_OVERFLOW"): return false
	if state.wallet_gold < 0 or rich.wallet_gold != INT64_MAX: return false
	# I. null GameState / uninitialized
	var bare: EconomyService = EcoScript.new()
	if not _reject_commit(bare, state, "catch-e4i", "river_carp", _utc(1), "NOT_INITIALIZED"): return false
	if not _reject_sell(bare, state, "sale-e4i", ["fish-catch-e4"], "NOT_INITIALIZED"): return false
	if not _reject_commit(svc, null, "catch-e4i", "river_carp", _utc(1), "NULL_GAME_STATE"): return false
	if not _reject_sell(svc, null, "sale-e4i", ["fish-catch-e4"], "NULL_GAME_STATE"): return false
