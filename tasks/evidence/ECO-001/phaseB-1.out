func _e4() -> bool:
	var svc: EconomyService = _svc()
	if svc == null: return _fail_ret("E4 setup")
	var state := GameState.new()
	# baseline: 1 valid fish in basket
	if not _apply_commit(svc, state, "catch-e4", "golden_trout", _utc(2)): return false
	# A. selling non-existent instance ID → UNKNOWN_INSTANCE
	if not _reject_sell(svc, state, "sale-e4a", ["fish-nope"], "UNKNOWN_INSTANCE"): return false
	# B. deduplication of duplicate IDs in list: [id, id] charges only once
	var before := _snap(state)
	var rr: Dictionary = svc.sell_fish(state, "sale-e4b", ["fish-catch-e4", "fish-catch-e4"])
	if rr.get("ok") != true or String(rr["code"]) != "" or int(rr["gold_added"]) != 32: fail
	if state.wallet_gold != int(before["wallet_gold"]) + 32: fail  # only added once
	# C. retry with same sale ID → ALREADY_APPLIED (covered in E3, reconfirmed here)
	if not _reject... ALREADY is ok=true, so custom:
	var rc: Dictionary = svc.sell_fish(state, "sale-e4b", ["fish-catch-e4"])
	if rc.get("ok") != true or String(rc["code"]) != "ALREADY_APPLIED" or int(rc["gold_added"]) != 0: fail
	if state.wallet_gold != 32: fail
	# D. malformed instance list
	if not _reject_sell(svc, state, "sale-e4d", [], "BAD_INSTANCE_LIST"): return false
	if not _reject_sell(svc, state, "sale-e4d", ["fish-catch-e4", 42], "BAD_INSTANCE_LIST"): return false
	if not _reject_sell(svc, state, "sale-e4d", [""], "BAD_INSTANCE_LIST"): return false
	if not _reject_sell(svc, state, "sale-e4d", "fish-catch-e4", "BAD_INSTANCE_LIST"): return false  # non-array
	# E. illegal species / illegal event ID / illegal timestamp
	if not _reject_commit(svc, state, "catch-e4e", "no_such_fish", _utc(3), "UNKNOWN_SPECIES"): return false
	if not _reject_commit(svc, state, "catch-e4e", 42, _utc(3), "UNKNOWN_SPECIES"): return false
	if not _reject_commit(svc, state, "", "river_carp", _utc(3), "BAD_EVENT_ID"): return false
	if not _reject_commit(svc, state, 42, "river_carp", _utc(3), "BAD_EVENT_ID"): return false
	if not _reject_commit(svc, state, "catch-e4e", "river_carp", "2026-13-01T00:00:00Z", "BAD_TIMESTAMP"): return false
	if not _reject_commit(svc, state, "catch-e4e", "river_carp", 12345, "BAD_TIMESTAMP"): return false
	# F. full basket commit rejected (capacity conflict)
	var full := GameState.new()
	for i in 10:
		if not _apply_commit(svc, full, "catch-full-%d" % i, "river_carp", _utc(i + 4)): return false
	if not _reject_commit(svc, full, "catch-full-overflow", "river_carp", _utc(1), "BASKET_FULL"): return false
	# G. corrupted fish in basket: malformed price → BAD_PRICE; malformed element → BAD_STATE
	var neg_price := GameState.new()
	neg_price.basket = [FishScript.make("catch-neg", _catalog["species"][0], _utc(1)).duplicate(true)...
```
Note — `FishScript.make(...)` returns a new dict each call; put it in basket and corrupt the price:
