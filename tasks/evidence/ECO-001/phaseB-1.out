_fsm returns a tuple of fsm and rng. Make it `_make_fsm() -> Array [fsm, rng]`.

```
	var parts := _make_fsm(4001)
	if parts.is_empty(): return _fail_ret("E1 setup")
	var fsm = parts[0]; var rng = parts[1]
	var state := GameState.new()
	var seen_ids := {}
	for i in 10:
		var cand := _catch_cycle(svc, fsm, state, _utc(i))
		if cand.is_empty(): return _fail_ret("E1 cycle %d" % i)
		var iid := "fish-" + String(cand["catch_event_id"])
		if seen_ids.has(iid): return _fail_ret("E1 duplicate instance_id")
		seen_ids[iid] = true
		if state.basket.size() != i + 1 or state.revision != i + 1: fail
	if state.basket.size() != 10: fail
	if fsm.can_cast(state): return _fail_ret("E1 can_cast must be false at full basket")
	var rng_before := int(rng.get_state())
	var rc: Dictionary = fsm.request_cast(state)
	if rc.get("ok") != false or String(rc["rejected_reason"]) != "BASKET_FULL" or String(rc["catch_event_id"]) != "": fail
	if int(rng.get_state()) != rng_before: return _fail_ret("E1 rejected cast consumed RNG")
	# selling 1 fish frees a slot, so casting can resume
	var sold_id := String((state.basket[0] as Dictionary)["instance_id"])
	var expect_gold := int((state.basket[0] as Dictionary)["sale_price_at_catch"])
	var sr: Dictionary = svc.sell_fish(state, "sale-e1", [sold_id])
	if sr.get("ok") != true or String(sr["code"]) != "" or int(sr["gold_added"]) != expect_gold or state.wallet_gold != expect_gold: fail
	if not fsm.can_cast(state): return _fail_ret("E1 can_cast must recover after sale")
	var rc2: Dictionary = fsm.request_cast(state)
	if rc2.get("ok") != true: fail
	return true
```

_catch_cycle uses the same svc/state:
```
func _catch_cycle(svc, fsm, state, utc) -> Dictionary:
	var rc: Dictionary = fsm.request_cast(state)
	if rc.get("ok") != true: return {}
	fsm.tick_effective(5.0); fsm.tick_effective(200.0); fsm.tick_effective(1.0); fsm.tick_effective(1.0)
	var cand: Dictionary = fsm.produce_catch_candidate()
	if cand.get("ok") != true: return {}
	var res: Dictionary = svc.commit_catch(state, String(cand["catch_event_id"]), String(cand["species_id"]), utc)
	if res.get("ok") != true or String(res["code"]) != "": return {}
	var ack: Dictionary = fsm.ack_settlement(String(cand["catch_event_id"]), true)
	if ack.get("ok") != true or String(ack["next_state"]) != "IDLE": return {}
	return cand
```
Note: the fsm.tick_effective call returns a typed Array[Dictionary] — assigning to an untyped var is fine; ignore the result: calling `fsm.tick_effective(5.0)` as a statement discards the value ✓.

Wait — E1: catch cycle: at the point of request_cast, if the basket is full (10), it fails — in the loop, at the start of cycle i the basket = i < 10 ✓, and the commit happens when the basket is i (<10) ✓.

