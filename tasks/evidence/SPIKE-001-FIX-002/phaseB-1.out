Edit 9 — new functions after the drag section (after _on_ship_gui_input, before the "---------- position persistence" section):
```gdscript
# ---------- SPIKE-001-FIX-002: drag mode A/B and scheme B native drag ----------

func _set_drag_mode(mode: String) -> void:
	_drag_mode = mode
	# Immediately reset drag state on switch (§3.1), so A/B can be tested independently (§9.3).
	_drag_pending = false
	_dragging = false
	_native_drag_active = false
	_log_event("drag_mode:%s" % ("a" if mode == "A" else "b"))
	_update_status()


func _toggle_fps_cap() -> void:
	# SDD-175: at startup always 30 (in _ready); key 7 only provides a 60 control for a single GUI session, not written into project settings.
	Engine.max_fps = 60 if Engine.max_fps != 60 else 30
	_log_event("fps_cap_toggle:%d" % Engine.max_fps)
	_update_status()


func _toggle_accumulated_input() -> void:
	# §9.5 experiment: use_accumulated_input (engine default true) merges mouse motions per frame
	# → under 30 FPS, A-mode window position update is capped at about 26.8Hz; turning off dispatches each motion event separately.
	if not _accum_input_supported:
		_log_event("accum_input_unsupported:Input.use_accumulated_input")
		return
	Input.use_accumulated_input = not Input.use_accumulated_input
	_log_event("accum_input:%s" % ("on" if Input.use_accumulated_input else "off"))
	_update_status()


func _start_native_drag(note: String) -> void:
	if not _window_start_drag_supported:
		# §3.1: when API is missing, honestly log and auto-handle with scheme A behavior, no silent degradation.
		if not _drag_unsupported_logged:
			_drag_unsupported_logged = true
			_log_event("drag_b_unsupported:DisplayServer.window_start_drag")
		return
	var wid := 0
	if _window_get_window_id_supported:
		wid = int(_win.call("get_window_id"))
	else:
		# Probe-based fallback (§3.1): if Window.get_window_id is missing, pass 0 (main window) and log honestly.
		_log_event("drag_b_window_id_fallback:0")
	DisplayServer.window_start_drag(wid)
	_native_drag_active = true
	_drag_pending = false
	_dragging = false
	_native_drag_samples = []
	_native_drag_sample_count = 0
	_log_event("native_drag_start:%s" % note)
	_update_status()


func _end_native_drag() -> void:
	if not _native_drag_active:
		return
	_native_drag_active = false
	_drag_pending = false
	_dragging = false
	# §9.2 semantics difference (README §2 matrix G-002e documents this explicitly): scheme B's 6px threshold degrades to post-hoc judgment ——
	# net window displacement since press <6px is counted as a click; ≥6px is counted as a drag.
	var net := Vector2(_win.position - _drag_start_win).length()
	if net < DRAG_THRESHOLD_PX:
		_ship_clicks += 1
		_log_event("ship_click")
	_log_event("native_drag_end:samples=%d:net_px=%.1f" % [_native_drag_sample_count, net])
	_save_position()
	_write_reports()
	_update_status()
```

Hmm, in on_press mode, if the OS doesn't actually drag (e.g., unsupported in this build → but we only call when supported) — the post-hoc judgment is fine either way.

