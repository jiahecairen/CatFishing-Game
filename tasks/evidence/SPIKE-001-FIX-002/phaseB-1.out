func _process(_delta: float) -> void:
	if _native_drag_active:
		# §3.2: the OS may swallow the release event → left-button mask polling fallback; also collect per-frame trajectory samples (§3.4).
		if Input.get_mouse_button_mask() & MOUSE_BUTTON_MASK_LEFT == 0:
