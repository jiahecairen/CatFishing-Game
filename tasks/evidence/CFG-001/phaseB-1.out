config_gate.gd:

```gdscript
class_name ConfigGate
extends RefCounted
static func can_start_economy(catalog: Dictionary, runtime: Dictionary) -> bool:
	return _ok(catalog) and _ok(runtime)
static func _ok(r: Dictionary) -> bool:
	return r.get("ok", false) == true and String(r.get("error_code", "")) == ""
static func blocked_reasons(catalog: Dictionary, runtime: Dictionary) -> PackedStringArray:
	var out := PackedStringArray()
	if not _ok(catalog): out.append("catalog:" + String(catalog.get("error_code", "UNKNOWN")))
	if not _ok(runtime): out.append("runtime:" + String(runtime.get("error_code", "UNKNOWN")))
	return out
```

