Let me write a thorough probe that tests manual recursion, and verify all paths including files, subdirectories, and the final directory deletion. Also test `DirAccess.open(path).get_current_dir()`... let me write a probe that runs manual recursion:

```gdscript
func rm_dir(path: String) -> int:
	var dir := DirAccess.open(path)
	if dir == null:
		return DirAccess.get_open_error()
	dir.list_dir_begin()
	var n := dir.get_next()
	var errs := 0
	while n != "":
		if dir.current_is_dir():
			var e := rm_dir(path + "/" + n)
			if e != OK: errs += 1
		else:
			var e := dir.remove(n)
			if e != OK: errs += 1
		n = dir.get_next()
	dir.list_dir_end()
	if errs > 0: return FAILED
	return DirAccess.remove_absolute(path)  # now empty
```

