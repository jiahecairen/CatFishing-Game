Next, I'll fix the test's `_remove_dir` with minimal changes. Current code (lines 710-716):

```gdscript
## In Godot 4, DirAccess.remove_recursive is an instance method: delete an absolute path from the root DirAccess.
func _remove_dir(path: String) -> void:
	var root_dir := DirAccess.open("/")
	if root_dir != null:
		var remove_error: int = root_dir.remove_recursive(path)
		if remove_error != OK and DirAccess.dir_exists_absolute(path):
			push_warning("SAVE001 cleanup failed for %s: %s" % [path, error_string(remove_error)])
```

Replace this with manual recursion that uses static remove_absolute for files and empty directories:

```gdscript
## Godot 4.7.2's DirAccess.remove_absolute does not do recursive deletion of non-empty directories (empirically returns FAILED),
## so recursively enumerate with open/list_dir, first delete child files and subdirectories, then delete the now-empty directory.
func _remove_dir(path: String) -> void:
	var dir := DirAccess.open(path)
	if dir == null:
		return
	dir.list_dir_begin()
	var name := dir.get_next()
	var failed := false
	while name != "":
		if dir.current_is_dir():
			_remove_dir(path + "/" + name)
		elif dir.remove(name) != OK:
			failed = true
		name = dir.get_next()
	dir.list_dir_end()
	var remove_error: int = DirAccess.remove_absolute(path)
	if (failed or remove_error != OK) and DirAccess.dir_exists_absolute(path):
		push_warning("SAVE001 cleanup failed for %s: %s" % [path, error_string(remove_error)])
```

