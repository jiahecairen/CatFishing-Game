Write the helper:

```gdscript
## JSON numeric → runtime type normalization (Godot 4.7.2 measurement: JSON.parse_string returns float for all
## JSON numbers). int-typed keys in disk round-trip snapshots must be restored by the out-of-scope-for-this-ticket
## DeterministicRng.restore_state / VirtualClock.restore_state / FishingStateMachine.initialize (strict `is int`),
## so at the save layer (the JSON boundary) we normalize floats with integer values to int per JSON Schema integer
## semantics; non-integer-value floats are returned as-is (already fail-closed rejected in SaveValidate; the
## normalization here produces no new acceptance).
static func _normalize_json_numbers(payload: Variant) -> Variant:
	if payload is Dictionary:
		var out_dict: Dictionary = {}
		for key in payload:
			out_dict[key] = _normalize_json_numbers(payload[key])
		return out_dict
	if payload is Array:
		var out_array: Array = []
		for element in payload:
			out_array.append(_normalize_json_numbers(element))
		return out_array
	if payload is float:
		var value := float(payload)
		if value - value == 0.0 and absf(value) < 9223372036854775808.0 and float(int(value)) == value:
			return int(value)
	return payload
```

