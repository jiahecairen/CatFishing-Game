Error DirAccess::remove_absolute(const String &p_path) {
	ERR_FAIL_COND_V(p_path.is_empty(), ERR_INVALID_PARAMETER);
	String top_dir = p_path;
	if (p_path[p_path.length() - 1] == '/' || p_path[p_path.length() - 1] == '\\') {
		top_dir = p_path.substr(0, p_path.length() - 1);
	}

	if (current_is_dir()) {
		Error err = list_dir_begin(false);
		ERR_CONTINUE(err);
		bool failed = false;
		while (true) {
			String f = get_next();
			if (f == "") {
				break; // end of list
			}
			if (f.begins_with(".")) {
				continue; // invisible and . / ..
			}
			if (current_is_dir()) {
				Error err = remove_absolute(top_dir.path_join(f).replace("\\", "/"));
				if (err == FAILED) {
					ERR_PRINT("Remove failed. Path: " + f);
					failed = true; //Prevents early failing
				}
			} else {
				Error err = remove(top_dir.path_join(f));
				if (err == FAILED) {
					ERR_PRINT("Remove failed. Path: " + f);
					failed = true; //Prevents early failing
				}
			}
		}
		list_dir_end();
		if (failed) {
			return FAILED;
		}
		Error err = _clear_internal_resource_cache(top_dir);
		ERR_PRINT...
		Error err = remove(top_dir);
		if (err) {
			ERR_PRINT("Remove folder failed at " + top_dir);
		}
		return err;
	}

	return remove(top_dir); // Path refers to file
}
```

