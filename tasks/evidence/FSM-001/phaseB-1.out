func _simulate(fsm, rng, clock, catalog, runtime, total, step, seed_val) -> Array[String]:
    rng.set_seed(seed_val); fsm.initialize(...); clock.reset()
    var timeline := []
    var t := 0.0
    while t < total:
        var evs := fsm.tick_effective(step)
        t += step
        for e in evs:
            timeline.append(_event_key(e))
        if fsm.get_state() == FSM.SETTLEMENT... 
```
