		return _fail_ret("F1 setup")
	var fsm: FishingStateMachine = parts[0]
	var rc: Dictionary = fsm.request_cast()
	if rc.get("ok") != true or not String(rc["catch_event_id"]).begins_with("catch-") or not (rc["wait_seconds"] is int):
		return _fail_ret("F1 request_cast envelope")
	var evs1: Array = fsm.tick_effective(5.0)
	if evs1.size() != 1 or evs1[0]["to_state"] != "WAITING":
		return _fail_ret("F1 CASTING->WAITING")
	var evs2: Array = fsm.tick_effective(200.0)
	if evs2.size() != 1 or evs2[0]["to_state"] != "HOOKED":
		return _fail_ret("F1 WAITING->HOOKED")
	var evs3: Array = fsm.tick_effective(1.0)
	... REELING
	var evs4: Array = fsm.tick_effective(1.0)
	... SETTLEMENT
	var cand := fsm.produce_catch_candidate()
	if cand.get("ok") != true or not ["river_carp","silver_perch","golden_trout"].has(cand["species_id"]):
		fail
	if (cand["weight_snapshot"] as Dictionary).is_empty(): fail
	var ack := fsm.ack_settlement(String(cand["catch_event_id"]), true)
	if ack.get("ok") != true or ack["next_state"] != "IDLE": fail
	if fsm.get_state() != FsmScript.State.IDLE: fail
	# Full order of transition_log
	var trans := []
	for entry in fsm.get_transition_log():
		if entry["action"] == "transition":
			trans.append("%s->%s" % [entry["from_state"], entry["to_state"]])
	if trans != ["IDLE->CASTING", "CASTING->WAITING", "WAITING->HOOKED", "HOOKED->REELING", "REELING->SETTLEMENT", "SETTLEMENT->IDLE"]:
		return _fail_ret("F1 transition order %s" % [str(trans)])
	return true
