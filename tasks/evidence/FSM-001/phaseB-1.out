```gdscript
class_name DeterministicRng
extends RefCounted
# comment

const MULTIPLIER := 48271
const MODULUS := 2147483647  # 2^31 - 1
const ERROR_BAD_SEED := "BAD_SEED"

var _state: int = 1
var _seed: int = 1

func set_seed(seed_value: int) -> Dictionary:
	if seed_value < 1 or seed_value >= MODULUS:
		return {"ok": false, "error_code": ERROR_BAD_SEED}
	_state = seed_value
	_seed = seed_value
	return {"ok": true, "error_code": ""}

func get_seed() -> int:
	return _seed

func next_int() -> int:
	_state = (MULTIPLIER * _state) % MODULUS
	return _state

func next_unit() -> float:
	return float(next_int()) / float(MODULUS)

func next_int_inclusive(lo: int, hi: int) -> int:
	if hi < lo:
		return lo
	var span := hi - lo + 1
	return lo + int(next_int() % span)
```

Note: 48271 * 2147483646 ≈ 1.0366e14 < 2^63 ✓. Lehmer requires state ∈ [1, m-1]; seed 1..m-1 ✓ (seed m-1: 48271*(m-1) mod m ∈ [1, m-1] ✓ since m is prime and state is never 0).

`set_seed` name collides with builtin? RNG has no builtin set_seed (RandomNumberGenerator has `seed` property). Function `set_seed` on RefCounted is fine.

VirtualClock:

```gdscript
class_name VirtualClock
extends RefCounted

var _now: float = 0.0

func advance(seconds: float) -> bool:
	if not _is_finite(seconds) or seconds < 0.0:
		return false
	_now += seconds
	return true

func now() -> float:
	return _now

func reset() -> void:
	_now = 0.0

static func _is_finite(value: float) -> bool:
	return value - value == 0.0
```

