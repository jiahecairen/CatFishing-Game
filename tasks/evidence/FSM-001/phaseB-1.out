F12 new:
```
func _f12() -> bool:
	var parts := _make(53)
	if parts.is_empty(): return _fail_ret("F12 setup")
	var fsm = parts[0]
	# Illegal durations: zero/negative/NaN/Inf → BAD_DURATION and no change
	for bad in [[0.0, 1.0, 1.0], [1.0, -2.0, 1.0], [NAN, 1.0, 1.0], [1.0, 1.0, INF]]:
		var bad_res: Dictionary = fsm.configure_stage_durations(bad[0], bad[1], bad[2])
		if bad_res.get("ok") != false or bad_res["code"] != "BAD_DURATION": fail
	# Default 1s behavior: after cast, exactly one CASTING→WAITING at tick 1.0, at_clock==1.0
	var rc: Dictionary = fsm.request_cast(GameState.new())
	var wait := int(rc["wait_seconds"])
	var e1: Array = fsm.tick_effective(1.0)
	if e1.size() != 1 or e1[0]["to_state"] != "WAITING" or float(e1[0]["at_clock"]) != 1.0: fail
	# Duration change forbidden mid-cycle
	if fsm.configure_stage_durations(2.0, 2.0, 2.0)["code"] != "BAD_TRANSITION": fail
	fsm.tick_effective(200.0) # → HOOKED
	fsm.tick_effective(1.0)   # → REELING
	fsm.tick_effective(1.0)   # → SETTLEMENT
	var cand: Dictionary = fsm.produce_catch_candidate()
	fsm.ack_settlement(String(cand["catch_event_id"]), true)  # → IDLE
	# Custom duration takes effect: 2.0/1.5/0.5
	if fsm.configure_stage_durations(2.0, 1.5, 0.5).get("ok") != true: fail
	var rc2: Dictionary = fsm.request_cast(GameState.new())
	var wait2 := int(rc2["wait_seconds"])
	var c1: Array = fsm.tick_effective(2.0)
	if c1.size() != 1 or c1[0]["to_state"] != "WAITING" or float(c1[0]["at_clock"]) != 2.0: fail
	var c2: Array = fsm.tick_effective(float(wait2))
	if c2.size() != 1 or c2[0]["to_state"] != "HOOKED" or float(c2[0]["at_clock"]) != 2.0 + float(wait2): fail
	var c3: Array = fsm.tick_effective(1.5)
	if c3.size() != 1 or c3[0]["to_state"] != "REELING" or float(c3[0]["at_clock"]) != 3.5 + float(wait2): fail
	var c4: Array = fsm.tick_effective(0.5)
	if c4.size() != 1 or c4[0]["to_state"] != "SETTLEMENT" or float(c4[0]["at_clock"]) != 4.0 + float(wait2): fail
	return true
```
