```gdscript
func _make(seed_value: int) -> Array:
	var rng: DeterministicRng = RngScript.new()
	var clock: VirtualClock = ClockScript.new()
	var seed_res: Dictionary = rng.set_seed(seed_value)
	if seed_res.get("ok") != true:
		return []
	var fsm: FishingStateMachine = FsmScript.new()
	var init: Dictionary = fsm.initialize(_catalog, _runtime, rng, clock, {})
	if init.get("ok") != true:
		return []
	return [fsm, rng, clock]
```
