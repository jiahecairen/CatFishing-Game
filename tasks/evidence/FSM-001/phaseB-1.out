### deterministic_rng.gd
Add:
```gdscript
## 运行态快照/恢复（review-followup #4：fail-closed 状态读取/恢复）。
func snapshot_state() -> Dictionary:
	return {"version": SNAPSHOT_VERSION, "state": _state}

func restore_state(snapshot: Variant) -> Dictionary:
	if not (snapshot is Dictionary):
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	var snap: Dictionary = snapshot
	if snap.size() != 2 or not snap.has("version") or not snap.has("state"):
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	if snap["version"] != SNAPSHOT_VERSION:
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	var raw_state: Variant = snap["state"]
	if not (raw_state is int) or int(raw_state) < 1 or int(raw_state) >= MODULUS:
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	_state = int(raw_state)
	return {"ok": true, "error_code": ""}

func get_state() -> int:
	return _state
```
