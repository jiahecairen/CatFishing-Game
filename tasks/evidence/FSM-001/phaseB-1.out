Design details:

**DeterministicRng additions:**
```gdscript
const SNAPSHOT_VERSION := 1
const ERROR_BAD_SNAPSHOT := "BAD_SNAPSHOT"

func get_state() -> int: return _state

func snapshot_state() -> Dictionary:
	return {"version": SNAPSHOT_VERSION, "state": _state}

func restore_state(snapshot: Variant) -> Dictionary:
	if not (snapshot is Dictionary):
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	var snap: Dictionary = snapshot
	if snap.size() != 2 or not snap.has("version") or not snap.has("state"):
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	if typeof(snap["version"]) != TYPE_INT or int(snap["version"]) != SNAPSHOT_VERSION:
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	var raw: Variant = snap["state"]
	if not (raw is int) or int(raw) < 1 or int(raw) >= MODULUS:
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	_state = int(raw)
	return {"ok": true, "error_code": ""}
```
Fail-closed: no change to state on any rejection (early return before mutation — that's how it is).

Note: restore does not modify _seed. Good (seed is a historical property).

**VirtualClock additions:**
```gdscript
const CLOCK_SNAPSHOT_VERSION := 1
const ERROR_BAD_SNAPSHOT := "BAD_SNAPSHOT"

func snapshot_state() -> Dictionary:
	return {"version": CLOCK_SNAPSHOT_VERSION, "now": _now}

func restore_state(snapshot: Variant) -> Dictionary:
	if not (snapshot is Dictionary):
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	var snap: Dictionary = snapshot
	if snap.size() != 2 or not snap.has("version") or not snap.has("now"):
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	if typeof(snap["version"]) != TYPE_INT or int(snap["version"]) != CLOCK_SNAPSHOT_VERSION:
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	var raw: Variant = snap["now"]
	if not _is_numeric(raw):
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	var value := float(raw)
	if not _is_finite(value) or value < 0.0:
		return {"ok": false, "error_code": ERROR_BAD_SNAPSHOT}
	_now = value
	return {"ok": true, "error_code": ""}

func get_now() -> float: return _now  (optional; now() exists)
```
VirtualClock needs a `_is_numeric` static (is_numeric check). Add a small static.

**FSM changes:**

a) Signature of request_cast:
```gdscript
const ERROR_NULL_STATE := "NULL_GAME_STATE"
const ERROR_BASKET_FULL := "BASKET_FULL"

func request_cast(state: GameState) -> Dictionary:
	if not _initialized:
		... NOT_INITIALIZED (log)
	if state == null:
		... NULL_GAME_STATE (log)  # don't consume RNG
	if _state != State.IDLE:
		... BAD_TRANSITION
	if state.basket.size() >= int(state.basket_capacity):
		... BASKET_FULL (log)
	# after that, sampling as before
```
Also `can_cast(state)` is kept as a read-only query.

Edge case: if basket_capacity is negative → size() >= capacity → reject. Good.

b) Candidate replay:
```gdscript
var _pending_candidate: Dictionary = {}

func produce_catch_candidate() -> Dictionary:
	if not _initialized: ...
	if _state != State.SETTLEMENT: ... BAD_TRANSITION
	if _candidate_issued:
		var replay := _pending_candidate.duplicate(true)
		_append_log("produce_catch_candidate", "SETTLEMENT", "SETTLEMENT", "CANDIDATE_REPLAYED", _current_event_id, {})
		return replay
	... sample ...
	_pending_candidate = payload
	_candidate_issued = true
	return payload.duplicate(true)
```
Here the payload contains ok/code/catch_event_id/species_id/weight_snapshot/caught_at_clock.
On ack success: `_pending_candidate = {}`. On request_cast success: `_pending_candidate = {}`. On initialize: `_pending_candidate = {}`.

