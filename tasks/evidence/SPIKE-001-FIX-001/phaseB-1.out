			# 修正 A：polygon 内接收鼠标事件、外穿透 → 多边形 = Ship 实际可交互矩形（非反向凹多边形）。
			# (Correction A: inside polygon receives mouse events, outside passes through → polygon = Ship's actual interactive rectangle (not inverted concave polygon).)
			var r: Rect2 = $Ship.get_global_rect()
			poly = PackedVector2Array([
				r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y),
			])
	var applied := false
	if _variant_api.get("mouse_passthrough", false):
		_win.set("mouse_passthrough", enable)
		applied = true
	if _variant_api.get("mouse_passthrough_polygon", false):
		_win.set("mouse_passthrough_polygon", poly)
	_variant = variant
	_variant_log.append({...})
```

