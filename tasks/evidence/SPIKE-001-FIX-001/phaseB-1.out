func _set_variant(variant: String) -> void:
	var supported := true
	var note := ""
	var enable := (variant == "full")
	var poly := PackedVector2Array()
	if variant == "polygon":
		enable = false
		if not _variant_api.get("mouse_passthrough_polygon", false):
			supported = false
			note = "mouse_passthrough_polygon 属性不存在 → 变体记 unsupported，退回整窗拦截 (mouse_passthrough_polygon property doesn't exist → log variant as unsupported, fall back to full-window interception)"
